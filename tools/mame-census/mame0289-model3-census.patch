+				(unsigned long long)tex_uploads, (unsigned long long)tex_texels, dl_max, cull_max, poly_max);
+		std::fprintf(f, ",%llu,%llu", (unsigned long long)texel_fetches, (unsigned long long)blocks_touched);
+		for (auto &c : caches) { std::fprintf(f, ",%llu", (unsigned long long)c.misses); c.max_misses = std::max(c.max_misses, c.misses); c.total_misses += c.misses; c.misses = 0; }
+		std::fprintf(f, ",%llu", (unsigned long long)fetches_d);
+		for (auto &c : caches_d) { std::fprintf(f, ",%llu", (unsigned long long)c.misses); c.max_misses = std::max(c.max_misses, c.misses); c.total_misses += c.misses; c.misses = 0; }
+		max_fetches_d = std::max(max_fetches_d, fetches_d);
+		fetches_d = 0;
+		std::fprintf(f, "\n");
+		max_texel_fetches = std::max(max_texel_fetches, texel_fetches);
+		max_blocks = std::max(max_blocks, blocks_touched);
+		texel_fetches = blocks_touched = 0;
+		max_polys = std::max(max_polys, polys);
+		max_tris = std::max(max_tris, tris_opaque + tris_alpha);
+		max_fetch = std::max(max_fetch, fetch_bytes);
+		max_texels = std::max(max_texels, tex_texels);
+		max_area = std::max(max_area, area);
+		renders = models = polys = polys_vrom = verts_new = verts_reused = fetch_bytes = 0;
+		tris_opaque = tris_alpha = tex_uploads = tex_texels = 0;
+		area = 0;
+		frame++;
+	}
