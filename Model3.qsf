set_instance_assignment -name ALLOW_SYNCH_CTRL_USAGE OFF -to *|SDRAM_*
# m2_sdram's address register, which that pattern does not name: without it, sd_a's constant loads become a
# synchronous clear and load, SDRAM_A[0-4] and [6-9] cannot pack into the I/O cells, and the board corrupts SDRAM
# (study R101). Only sd_a: on the whole controller it unpacks the DQ input registers instead.
set_instance_assignment -name ALLOW_SYNCH_CTRL_USAGE OFF -to "*|m3_system:sys3|m2_sdram:u_sdram|sd_a[*]"
# The same for the second SDRAM's controller (the dual build's m3_sdr2, D-66): without it c125d_s1 left SDRAM2_A[*]
# out of the I/O cells (18 x Warning 176279, as snd2's fits). Matches nothing in a single-SDRAM build.
set_instance_assignment -name ALLOW_SYNCH_CTRL_USAGE OFF -to "*|m3_system:sys3|m3_sdr2:g_w2.u_sdr2|m2_sdram:u_sdram|sd_a[*]"
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to ADC_CONVST
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to ADC_SCK
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to ADC_SDI
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to ADC_SDO
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to AUDIO_*
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to BTN_*
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to FPGA_CLK1_50
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to FPGA_CLK2_50
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to FPGA_CLK3_50
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to HDMI_I2C_*
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to HDMI_I2S
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to HDMI_LRCLK
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to HDMI_MCLK
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to HDMI_SCLK
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to HDMI_TX_*
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to IO_S*
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to KEY[0]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to KEY[1]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to LED[0]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to LED[1]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to LED[2]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to LED[3]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to LED[4]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to LED[5]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to LED[6]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to LED[7]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to LED_*
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to SDCD_SPDIF
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to SDIO_*
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to SDRAM_*
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to SD_SPI*
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to SW[0]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to SW[1]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to SW[2]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to SW[3]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to USER_IO[*]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to VGA_*
set_instance_assignment -name WEAK_PULL_UP_RESISTOR ON -to BTN_*
set_instance_assignment -name WEAK_PULL_UP_RESISTOR ON -to IO_S*
set_instance_assignment -name WEAK_PULL_UP_RESISTOR ON -to SDCD_SPDIF
set_instance_assignment -name WEAK_PULL_UP_RESISTOR ON -to SDIO_CMD
set_instance_assignment -name WEAK_PULL_UP_RESISTOR ON -to SDIO_DAT[*]
set_instance_assignment -name WEAK_PULL_UP_RESISTOR ON -to SD_SPI*
set_instance_assignment -name WEAK_PULL_UP_RESISTOR ON -to USER_IO[*]
set_instance_assignment -name WEAK_PULL_UP_RESISTOR ON -to VGA_EN
# Step 2 (Daytona 2) bus map and texture-upload port (study R100)
set_global_assignment -name VERILOG_MACRO "M3_STEP2_BUS=1"
set_global_assignment -name VERILOG_MACRO "M3_STEP2_TEX=1"
# The Real3D DMA at the bus's rate (study R144): r3d_cmd's 32 posted writes and r3d_mem's 8E writes gathered into
# four-word SDRAM bursts. Off together they give the one held access and 8E's single halfword writes.
set_global_assignment -name VERILOG_MACRO "M3_DMAFAST=1"
set_global_assignment -name VERILOG_MACRO "M3_R3B=1"
# Release builds: every debug block off together (m3_system RELEASE: the overlay and its capture, CPI_MON, FBUSY;
# about 2,400 ALM at 100 MHz, study R105). Test builds leave this commented out.
#set_global_assignment -name VERILOG_MACRO "M3_RELEASE=1"
# The cabinet's driving block without Model 2's "Steering", "Steering smoothing" and "Analog control"
# (m3_cab_inputs). Off: the full block is built, with its OSD lines.
#set_global_assignment -name VERILOG_MACRO "M3_INP_LEAN=1"
# The frame-time measurement in a release build (m3_frame_busy and overlay rows 6-7: each frame against the vblank,
# split into Real3D DMA wait and the rest; study R188). Board measurement builds only.
#set_global_assignment -name VERILOG_MACRO "M3_FBUSY_BUILD=1"
# D-85: changes from the contributor's fork, each off until board-tested (m3_system's header lists them). M3_DMADIR:
# Step 2 DMA moves write the Real3D straight from the move engine; M3_R3LATE: a frame missed at its flip starts late,
# not dropped; M3_R3EMPTY: the geometry drops triangles that cover no pixel; M3_R3PF: the display-list walker reads
# ahead; M3_SND_WD13: the sound bridge's watchdog at 186 ms, not 93
set_global_assignment -name VERILOG_MACRO "M3_DMADIR=1"
#set_global_assignment -name VERILOG_MACRO "M3_R3LATE=1"
#set_global_assignment -name VERILOG_MACRO "M3_R3EMPTY=1"
#set_global_assignment -name VERILOG_MACRO "M3_R3PF=1"
set_global_assignment -name VERILOG_MACRO "M3_SND_WD13=1"
# The core PLL's outputs stay separate counters even when two of them match (SDRAM_CLK and SDRAM2_CLK at the same
# phase): Quartus would otherwise merge outclk_3 into outclk_2, and Model3.sdc's sd2_pin and the second SDRAM's I/O
# constraints would then match nothing (c135y_s1, 2026-11-20). As sys/pll_hdmi does for its PLL.
set_instance_assignment -name UNFORCE_MERGE_PLL_OUTPUT_COUNTER ON -to "*pll_0002*|altera_pll:altera_pll_i*|*"

# sys140: the DQ capture clocks (outclk_4 / outclk_5) on global clocks, so the DQ pins' input registers (in banks 3A,
# 3B, 4A, 5A, 5B and 8A) can all be in their I/O cells: on a regional clock (t1_s1, outclk_4 on CLKCTRL_R76) the
# first SDRAM's went into the core at X46 Y35
# (with the dynamic-phase ports the PLL is built as altera_cyclonev_pll and its outputs are divclk[n]: t2_s1's
# outclk_wire[4] assignment matched nothing, and outclk_4 went on CLKCTRL_R33 again)
set_instance_assignment -name GLOBAL_SIGNAL "GLOBAL CLOCK" -to "emu:emu|pll:pll|pll_0002:pll_inst|altera_pll:altera_pll_i|altera_cyclonev_pll:cyclonev_pll|divclk[4]"
set_instance_assignment -name GLOBAL_SIGNAL "GLOBAL CLOCK" -to "emu:emu|pll:pll|pll_0002:pll_inst|altera_pll:altera_pll_i|altera_cyclonev_pll:cyclonev_pll|divclk[5]"
# sys140: the tile generator's line start into its palette, its line buffers and its fetch (t1_s1: 185 + 27 endpoints,
# -2.0 / -2.1 ns, the one register's route)
set_instance_assignment -name MAX_FANOUT 16 -to "emu:emu|m3_system:sys3|tg_go"
# sys140: m3_xmem's own reset copy, duplicated
set_instance_assignment -name MAX_FANOUT 64 -to "emu:emu|m3_system:sys3|rst_xm"
set_global_assignment -name VERILOG_MACRO "M3_DIRN=1024"

# The scaler's 13 DSP blocks are held in the two far columns (X54, X86), rows 20-35, where the fitter puts most of
# them anyway. That leaves the two near columns (X20, X32: 78 blocks) to the Real3D, whose block paths do not close
# from a far column at 140 MHz (study R207: r3_s2's reciprocal in a far column put specks on the screen). The CPU's
# and the sound's blocks are free. If ascal's multiplier names change these lines stop matching: the fit report's
# DSP Block Details must show no r3d_ block in X54 or X86.
set_location_assignment DSP_X86_Y35_N0 -to "ascal:ascal|Add227~8"
set_location_assignment DSP_X54_Y35_N0 -to "ascal:ascal|Add228~8"
set_location_assignment DSP_X86_Y33_N0 -to "ascal:ascal|Add229~8"
set_location_assignment DSP_X54_Y33_N0 -to "ascal:ascal|Add230~8"
set_location_assignment DSP_X86_Y30_N0 -to "ascal:ascal|Add231~8"
set_location_assignment DSP_X54_Y30_N0 -to "ascal:ascal|Add232~8"
set_location_assignment DSP_X86_Y28_N0 -to "ascal:ascal|Add170~8"
set_location_assignment DSP_X54_Y28_N0 -to "ascal:ascal|Add171~8"
set_location_assignment DSP_X86_Y26_N0 -to "ascal:ascal|Add172~8"
set_location_assignment DSP_X54_Y26_N0 -to "ascal:ascal|Add173~8"
set_location_assignment DSP_X86_Y24_N0 -to "ascal:ascal|Add168~8"
set_location_assignment DSP_X54_Y24_N0 -to "ascal:ascal|Add169~8"
set_location_assignment DSP_X86_Y22_N0 -to "ascal:ascal|Mult14~8"

