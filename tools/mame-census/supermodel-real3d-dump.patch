+  // Model 3 census: M3DUMP_DIR saves the Real3D memories every M3DUMP_EVERY frames
+  // from M3DUMP_START, for replay through MAME's renderer. M3DUMP_EXIT ends the run.
+  // Run with -no-gpu-thread so the live arrays are the ones being drawn.
+  static const char *dumpDir = std::getenv("M3DUMP_DIR");
+  static const int every = std::getenv("M3DUMP_EVERY") ? std::atoi(std::getenv("M3DUMP_EVERY")) : 30;
+  static const int start = std::getenv("M3DUMP_START") ? std::atoi(std::getenv("M3DUMP_START")) : 0;
+  static const int stop = std::getenv("M3DUMP_EXIT") ? std::atoi(std::getenv("M3DUMP_EXIT")) : 0;
+  static int frame = 0;
+  if (dumpDir && frame >= start && (frame - start) % every == 0)
+  {
+    char name[512];
+    std::snprintf(name, sizeof(name), "%s/f%06d.bin.gz", dumpDir, frame);
+    if (gzFile f = gzopen(name, "wb1"))
+    {
+      gzwrite(f, cullingRAMLo, 0x400000);   // 8C000000, MAME m_culling_ram
+      gzwrite(f, cullingRAMHi, 0x100000);   // 8E000000, MAME m_display_list_ram
+      gzwrite(f, polyRAM, 0x400000);
+      gzwrite(f, textureRAM, 0x800000);     // 2048 x 2048, page 1 from row 1024
+      gzclose(f);
+    }
+  }
+  static const char *shotDir = std::getenv("M3SHOT_DIR");
+  static const int shotEvery = std::getenv("M3SHOT_EVERY") ? std::atoi(std::getenv("M3SHOT_EVERY")) : 600;
+  static const char *shotList = std::getenv("M3SHOT_LIST");	// comma-separated frame numbers, instead of every M3SHOT_EVERY
+  bool listed = false;
+  if (shotList)
+  {
+    char key[16];
+    std::snprintf(key, sizeof(key), ",%d,", frame);
+    listed = std::strstr((std::string(",") + shotList + ",").c_str(), key) != nullptr;
+  }
+  if (shotDir && (shotList ? listed : frame % shotEvery == 0))
+  {
+    extern void M3Shot(const char *, int);
+    M3Shot(shotDir, frame);
+  }
+  extern void m3cpu_frame();
+  m3cpu_frame();
+  frame++;
+  if (stop && frame >= stop)
+    std::exit(0);
+  Render3D->RenderFrame();
 }
 
