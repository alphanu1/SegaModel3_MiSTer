+	/*
+	 * The sweep records one entry per busy instruction (cache outcomes already resolved on
+	 * the shared caches) and replays the frame's entries through every option at the end
+	 * of the frame, the options split over worker threads.
+	 */
+	struct fp_rec
+	{
+		int8_t src[4], dst[3];
+		uint8_t lat, busy, unit, extra, fclass, ic_miss, ld_miss, io_ld, io_st, bub, redirect, idle, xu, ld, nl, misp, regtgt, wmiss, fpld, btb64, btb256;
+	};
+	std::vector<fp_rec> recs;
+	uint64_t ld_hit_pred = 0, ld_way_miss = 0;	// shared D-cache load hits in the predicted / another way
+	struct btb_entry { UINT32 pc = ~0u, target = 0; };
+	std::vector<btb_entry> btb64 = std::vector<btb_entry>(64), btb256 = std::vector<btb_entry>(256);
+	uint64_t taken_br = 0, btb64_hit = 0, btb256_hit = 0;
+
+	void step_fpu(UINT32 pc, UINT32 op, UINT32 npc, int redirect, int bub, m3cpi_decoded d)
+	{
+		m3cpi_decode_fp(op, d);
+		fp_rec r;
+		r.ic_miss = sic.access(pc, false) ? 1 : 0;
+		int ld_miss = 0, io_ld = 0, io_st = 0, way_miss = 0;
+		for (int i = 0; i < nmem; i++)
+		{
+			if (!cacheable(mem[i].addr)) { (mem[i].write ? io_st : io_ld)++; continue; }
+			for (uint64_t a = mem[i].addr & ~31ull; a <= ((uint64_t(mem[i].addr) + mem[i].size - 1) & ~31ull); a += 32)	// 64-bit: an access at the top of the address space must not wrap the loop
+			{
+				int wm = 0;
+				if (sdc.access(a, mem[i].write, &wm) && !mem[i].write) ld_miss++;
+				else if (!mem[i].write && wm) way_miss++;
+				else if (!mem[i].write) ld_hit_pred++;
+			}
+		}
+		ld_way_miss += way_miss;
+		for (int k = 0; k < 4; k++) r.src[k] = d.src[k] == R_NONE ? -1 : d.src[k];
+		for (int k = 0; k < 3; k++) r.dst[k] = d.dst[k] == R_NONE ? -1 : d.dst[k];
+		r.lat = d.lat; r.busy = d.busy; r.unit = d.unit; r.extra = d.extra; r.fclass = d.fclass;
+		r.ld_miss = ld_miss; r.io_ld = io_ld; r.io_st = io_st; r.bub = bub; r.redirect = redirect; r.idle = 0;
