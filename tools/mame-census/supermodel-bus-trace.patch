+void CModel3::Write8(UINT32 addr, UINT8 data) { M3BusGuard g; if (g.top || g_m3bus_master) m3bus_log(1, 1, addr, data); Write8Impl(addr, data); }
+void CModel3::Write16(UINT32 addr, UINT16 data) { M3BusGuard g; if (g.top || g_m3bus_master) m3bus_log(1, 2, addr, data); Write16Impl(addr, data); }
+void CModel3::Write32(UINT32 addr, UINT32 data) { M3BusGuard g; if (g.top || g_m3bus_master) m3bus_log(1, 4, addr, data); Write32Impl(addr, data); }
+void CModel3::Write64(UINT32 addr, UINT64 data) { M3BusGuard g; if (g.top || g_m3bus_master) m3bus_log(1, 8, addr, data); Write64Impl(addr, data); }
