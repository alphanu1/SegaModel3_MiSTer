+			// unit's multiplier, blocking the FP pipeline for L cycles; singles and the frsqrte estimate
+			// on the latency-6 fast path as l6_
+			for (int L : { 16, 24, 32 })
+				for (const char *lev : { "ld1b_r2_n1_w2_d0", "ld1b_b256_n1_w2_d0", "ld1b_r2_n1_w2_da", "ld1b_b256_n1_w2_da" })
