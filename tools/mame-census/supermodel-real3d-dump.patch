+	}
+	void idle_fpu()
+	{
+		if (!recs.empty() && recs.back().idle) return;
+		fp_rec r{}; r.idle = 1; recs.push_back(r);
+	}
+
+	static void replay(m3cpi_fcfg &c, std::vector<fp_rec> const &recs)
+	{
+		for (fp_rec const &r : recs)
+		{
+			if (r.idle) { c.pending_bubbles = 0; c.last_pairable = false; continue; }
+			if (c.fpu.fold && r.xu == 4)
+			{
+				uint64_t const gate = c.last + (r.ic_miss ? c.stall : 0);
+				uint64_t dep = 0;
+				for (int s : r.src) if (s >= 0 && c.ready[s] > dep) dep = c.ready[s];
+				for (int x : r.dst) if (x >= 0) c.ready[x] = std::max(c.last, dep) + 1;
+				uint64_t nxt = 0;
+				if (r.misp) nxt = std::max(dep, gate) + 2;
+				else if (r.regtgt) nxt = std::max(dep, gate) + 1;
+				else if (r.ic_miss) nxt = gate + 1;
+				if (nxt > c.min_next) c.min_next = nxt;
+				c.pending_bubbles = 0;
+				continue;
+			}
+			// dual dispatch: a second instruction may issue in the same cycle as the previous
+			// one if nothing intervenes and the two go to different units
+			bool const fpop = r.xu == 2 && r.fclass != FC_FPSCR;
+			bool const pair = c.fpu.dual && c.slot == 1 && c.last_pairable && !c.pending_bubbles && !r.redirect && !r.ic_miss && !r.extra && r.xu != c.last_xu
+				&& (c.fpu.dual_mode != 2 || fpop != c.last_fpop);
+			int const bubbles = c.pending_bubbles;
+			uint64_t t = c.last + (pair ? 0 : 1) + bubbles + r.redirect + (c.fpu.icbuilt && r.nl ? c.fpu.nl_cost : 0);
+			t += uint64_t(r.ic_miss) * (c.fpu.icbuilt ? c.ist : c.stall);
+			if (c.min_next > t) t = c.min_next;
+			for (int s : r.src) if (s >= 0 && c.ready[s] > t) t = c.ready[s];
+			int const fc = r.fclass;
+			int lat = r.lat, busy = r.busy, unit = r.unit;
+			if (fc != FC_NONE) { lat = c.fpu.c[fc].lat; busy = c.fpu.c[fc].busy; unit = c.fpu.c[fc].unit; }
+			if (unit == FU_PIPE && c.fpu_free > t) t = c.fpu_free;
+			if (unit == FU_DIV && c.fdiv_free > t) t = c.fdiv_free;
+			if (unit == 2 && c.div_free > t) t = c.div_free;
+			bool const fast = c.fpu.fast_wb && (fc == FC_S_ADD || fc == FC_S_MUL || fc == FC_S_FMA || (fc == FC_FRSQRTE && unit == FU_PIPE));
+			if (fast && c.pipe_due + 1 > t + c.fpu.fast_lat) t = c.pipe_due + 1 - c.fpu.fast_lat;
+			if (((c.fpu.serial && (fc == FC_CMP || fc == FC_FPSCR)) || (c.fpu.serial_fpscr && fc == FC_FPSCR)) && c.drain > t) t = c.drain;
