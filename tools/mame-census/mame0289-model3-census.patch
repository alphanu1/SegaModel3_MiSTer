+   footprint, per-frame polygon, vertex, triangle, texture-upload and
+   triangle-area counts. */
+namespace {
+struct m3b_census
+{
+	bool on = false;
+	std::FILE *f = nullptr;
+	std::string prefix;
+	std::vector<uint8_t> dl_w, cull_w, poly_w;
+	uint32_t dl_max = 0, cull_max = 0, poly_max = 0;
+	uint64_t models = 0, polys = 0, polys_vrom = 0, verts_new = 0, verts_reused = 0, fetch_bytes = 0;
+	uint64_t tris_opaque = 0, tris_alpha = 0, tex_uploads = 0, tex_texels = 0, renders = 0, bad_uploads = 0, bad_addresses = 0;
+	double area = 0;
+	uint64_t frame = 0;
+	double max_area = 0;
+
+	// textures: sheet tiles written (8x8 texels), and a texel-cache model
+	std::vector<uint8_t> tile_w = std::vector<uint8_t>(2 * 256 * 128);
+	std::vector<uint8_t> blk_r = std::vector<uint8_t>(2 * 512 * 256);   // 4x4 blocks ever read
+	std::vector<uint32_t> blk_stamp = std::vector<uint32_t>(2 * 512 * 256);
+	uint64_t texel_fetches = 0, blocks_touched = 0, max_texel_fetches = 0, max_blocks = 0;
+	struct cache
+	{
+		int kib, ways, setbits, xbits;
+		std::vector<uint32_t> tag, age;
+		uint64_t misses = 0, max_misses = 0, total_misses = 0;
+		cache(int k, int w) : kib(k), ways(w)
+		{
+			int const sets = k * 1024 / 32 / w;
+			setbits = 0;
+			while ((1 << setbits) < sets) setbits++;
+			xbits = (setbits + 1) / 2;
+			tag.assign(sets * w, ~0U);
+			age.assign(sets * w, 0);
+		}
+		void access(uint32_t blk, uint32_t bx, uint32_t by, uint32_t page, uint32_t now)
+		{
+			uint32_t const set = ((bx & ((1 << xbits) - 1)) | ((by ^ (page << 3)) << xbits)) & ((1 << setbits) - 1);
+			uint32_t *t = &tag[set * ways], *a = &age[set * ways];
+			int victim = 0;
+			for (int w = 0; w < ways; w++)
+			{
+				if (t[w] == blk) { a[w] = now; return; }
+				if (a[w] < a[victim]) victim = w;
+			}
+			t[victim] = blk;
+			a[victim] = now;
+			misses++;
+		}
