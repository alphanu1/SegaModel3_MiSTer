+			if (unit == FU_PIPE && busy) c.fpu_free = t + busy;
+			if (unit == FU_DIV) c.fdiv_free = t + busy;
+			if (unit == 2) c.div_free = t + busy;
+			if (fc != FC_NONE && t + lat > c.drain) c.drain = t + lat;
+			if (unit == FU_PIPE && fc != FC_NONE && t + lat > c.pipe_due) c.pipe_due = t + lat;
+			if (t == c.last && c.slot == 1) c.slot = 2;
+			else { c.slot = 1; c.last_xu = r.xu; c.last_fpop = fpop; c.last_pairable = !r.extra && !r.ld_miss && !r.io_ld && !r.io_st; }
+			c.last = t;
+			int nb = r.bub;
+			if (c.fpu.icbuilt && r.bub)
+			{	// built I-side: a misprediction costs 2; a correctly predicted taken branch costs the
+				// redirect, or nothing on a BTB hit
+				if (r.misp) nb = 2;
+				else if ((c.fpu.btb == 64 && r.btb64) || (c.fpu.btb == 256 && r.btb256)) nb = 0;
+				else nb = c.fpu.redirect;
+			}
+			c.pending_bubbles = nb;
+		}
+	}
+
+	void flush_fpu()
+	{
+		if (fcfg.empty()) return;
+		unsigned const nt = std::min<size_t>(8, fcfg.size());
+		std::vector<std::thread> th;
+		for (unsigned w = 0; w < nt; w++)
+			th.emplace_back([this, w, nt]() { for (size_t i = w; i < fcfg.size(); i += nt) replay(fcfg[i], recs); });
+		for (auto &x : th) x.join();
+		recs.clear();
+	}
+
+	static bool cacheable(UINT32 a) { return a < 0x00800000 || a >= 0xff000000; }
+
+	int branch_bubbles(UINT32 pc, UINT32 op, UINT32 npc)
+	{
+		bool const taken = npc != pc + 4;
+		int const p = op >> 26;
+		if (p == 18) return 1;
+		if (p == 16)
+		{
+			int const bo = (op >> 21) & 31;
+			if ((bo & 0x14) == 0x14) return 1;
+			bool const backward = (op & 0x8000) != 0;
+			bool const predict = backward ^ ((bo & 1) != 0);
+			if (taken == predict) return taken ? 1 : 0;
+			return 2;
+		}
+		if (p == 19 && (((op >> 1) & 0x3ff) == 16 || ((op >> 1) & 0x3ff) == 528)) return taken ? 2 : 0;
+		return 0;
+	}
+
+	void step(UINT32 pc, UINT32 op, UINT32 npc, bool idle)
+	{
+		if (idle) { nmem = 0; have_prev = false; for (auto &c : cfg) c.pending_bubbles = 0; if (!fcfg.empty()) idle_fpu(); return; }
+		int redirect = 0;
+		if (have_prev && pc != prev_npc) redirect = 4;	// exception or interrupt entry
+		m3cpi_decoded d;
+		m3cpi_decode(op, d);
+		int const bub = branch_bubbles(pc, op, npc);
+		for (auto &c : cfg)
+		{
+			uint64_t t = c.last + 1 + c.pending_bubbles + redirect;
+			if (c.penalty && c.ic.access(pc, false)) t += c.stall;
+			for (int s : d.src) if (s != R_NONE && c.ready[s] > t) t = c.ready[s];
+			if (d.unit == 1 && c.fpu_free > t) t = c.fpu_free;
+			if (d.unit == 2 && c.div_free > t) t = c.div_free;
+			for (int i = 0; i < nmem; i++)
+			{
+				if (!cacheable(mem[i].addr)) { t += mem[i].write ? 2 : 20; continue; }
+				if (!c.penalty) continue;
+				for (uint64_t a = mem[i].addr & ~31ull; a <= ((uint64_t(mem[i].addr) + mem[i].size - 1) & ~31ull); a += 32)	// 64-bit: an access at the top of the address space must not wrap the loop
+				{
+					int r = c.dc.access(a, mem[i].write);
+					if (!r) continue;
+					if (c.storebuf && mem[i].write) continue;	// write buffer absorbs it
+					t += c.stall + (r == 2 && !c.storebuf ? c.penalty / 2 : 0);
+				}
+			}
+			t += d.extra;
+			for (int x : d.dst) if (x != R_NONE) c.ready[x] = t + d.lat;
+			if (d.unit == 1 && d.busy) c.fpu_free = t + d.busy;
+			if (d.unit == 2) c.div_free = t + d.busy;
+			c.last = t;
+			c.pending_bubbles = bub;
+		}
+		if (!fcfg.empty())
+			step_fpu(pc, op, npc, redirect, bub, d);
+		prev_pc = pc; prev_op = op; prev_npc = npc; have_prev = true;
+		nmem = 0;
+	}
+	void record(UINT32 addr, unsigned size, bool write)
+	{
+		if (nmem < 128) mem[nmem++] = memop{ addr, size, write };
+	}
+};
