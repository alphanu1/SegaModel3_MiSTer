+			t += uint64_t(r.io_st) * c.io_store + uint64_t(r.io_ld) * c.io_load + uint64_t(r.ld_miss) * (c.fpu.icbuilt ? c.dst : c.stall);
+			t += r.extra;
+			if (c.fpu.load2) t += r.ld;
+			if (c.fpu.ld1b && r.ld) { t += c.fpu.wm_cost * r.wmiss + r.fpld; if (!c.fpu.ld_use2) lat += 1; }
