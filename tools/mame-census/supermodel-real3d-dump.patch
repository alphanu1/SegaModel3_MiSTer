+				a.pc = b.pc = pc; a.target = b.target = npc;
+				taken_br++; btb64_hit += r.btb64; btb256_hit += r.btb256;
+			}
+			if (p == 16 && cond) r.misp = taken != (((op & 0x8000) != 0) ^ ((bo & 1) != 0));
