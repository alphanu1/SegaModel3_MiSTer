+        std::fwrite(polyRAM, 1, 0x400000, fp);
+        std::fwrite(textureRAM, 1, 0x800000, fp);
+        std::fclose(fp);
+      }
+      g_m3sb_grab = int(f);
+    }
+  }
+  Render3D->RenderFrame();
 }
 
