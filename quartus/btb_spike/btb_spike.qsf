set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CSEBA6U23I7
set_global_assignment -name TOP_LEVEL_ENTITY btb_spike_top
set_global_assignment -name LAST_QUARTUS_VERSION "17.0.0 Lite Edition"
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name SDC_FILE btb_spike.sdc
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/cpu/ppc_btb.sv
set_global_assignment -name SYSTEMVERILOG_FILE btb_spike_top.sv
set_global_assignment -name OPTIMIZATION_MODE "HIGH PERFORMANCE EFFORT"
set_global_assignment -name FINAL_PLACEMENT_OPTIMIZATION ALWAYS
set_global_assignment -name PHYSICAL_SYNTHESIS_COMBO_LOGIC ON
set_global_assignment -name PHYSICAL_SYNTHESIS_REGISTER_DUPLICATION ON
set_global_assignment -name PHYSICAL_SYNTHESIS_REGISTER_RETIMING ON
set_global_assignment -name OPTIMIZATION_TECHNIQUE SPEED
set_global_assignment -name NUM_PARALLEL_PROCESSORS 4
set_global_assignment -name SEED 1
set_parameter -name N 256
set_parameter -name XW 0
set_parameter -name STYLE 0
set_instance_assignment -name VIRTUAL_PIN ON -to rst
set_instance_assignment -name VIRTUAL_PIN ON -to rd_pc*
set_instance_assignment -name VIRTUAL_PIN ON -to ctx*
set_instance_assignment -name VIRTUAL_PIN ON -to cap
set_instance_assignment -name VIRTUAL_PIN ON -to p_*
set_instance_assignment -name VIRTUAL_PIN ON -to kill
set_instance_assignment -name VIRTUAL_PIN ON -to w_*
set_instance_assignment -name VIRTUAL_PIN ON -to flush
set_instance_assignment -name VIRTUAL_PIN ON -to busy
