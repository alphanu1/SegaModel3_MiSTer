+struct m3cpu_census
+{
+	bool on = false;
+	std::string prefix;
+	std::FILE *f = nullptr;
+	std::vector<std::pair<UINT32, UINT32>> idle;
+	std::vector<uint64_t> pc_ram = std::vector<uint64_t>(0x800000 / 4);
+	std::vector<UINT32> op_ram = std::vector<UINT32>(0x800000 / 4);
+	uint64_t f_insn = 0, f_idle = 0, f_rom = 0, total = 0, frame = 0;
+	m3cpi_model cpi;
+	m3fp::census fpc;		// M3FP=<prefix>: FP operand census (m3fp_census.h)
+	m3cpu_census()
+	{
+		const char *p = std::getenv("M3CPU");
+		if (!p)
+			return;
+		on = true;
+		prefix = p;
+		f = std::fopen((prefix + "_cpu_frames.csv").c_str(), "w");
+		if (std::getenv("M3CPI"))
+			cpi.init();
+		std::fprintf(f, "frame,insn,idle,rom");
+		for (auto const &c : cpi.cfg) std::fprintf(f, ",cyc_%s", c.name);
+		for (auto const &c : cpi.fcfg) std::fprintf(f, ",cyc_%s", c.name.c_str());
+		std::fprintf(f, "\n");
+		if (const char *fp = std::getenv("M3FP"))
+			fpc.init(fp);
+		if (const char *s = std::getenv("M3IDLE"))
+		{
+			std::string list(s), item;
+			size_t pos = 0;
+			while (pos <= list.size())
+			{
+				size_t comma = list.find(',', pos);
+				if (comma == std::string::npos) comma = list.size();
+				item = list.substr(pos, comma - pos);
+				size_t dash = item.find('-');
+				if (dash != std::string::npos)
+					idle.emplace_back(std::stoul(item.substr(0, dash), nullptr, 16), std::stoul(item.substr(dash + 1), nullptr, 16));
+				pos = comma + 1;
+			}
+		}
+	}
+	~m3cpu_census()
+	{
+		if (!on)
+			return;
+		std::fclose(f);
+		fpc.dump([this](UINT32 pc) {
+			std::string s;
+			for (UINT32 a = pc - 16; a <= pc + 40; a += 4)
+			{
+				char line[160], mnem[32] = "", oprs[96] = "";
+				UINT32 const w = a < 0x800000 ? op_ram[a >> 2] : 0;
+				if (w) DisassemblePowerPC(w, a, mnem, oprs, sizeof(oprs), true);
+				std::snprintf(line, sizeof(line), "%s %08X  %08X  %-8s %s\n", a == pc ? ">" : " ", a, w, w ? mnem : "(not run)", oprs);
+				s += line;
+			}
+			return s;
+		});
+		std::FILE *o = std::fopen((prefix + "_cpu.txt").c_str(), "w");
+		std::fprintf(o, "frames %llu\ninstructions %llu\n", (unsigned long long)frame, (unsigned long long)total);
+		if (!cpi.fcfg.empty())
+			std::fprintf(o, "shared D-cache load hits: predicted way %llu, other way %llu\ntaken branches %llu, BTB hits: 64-entry %llu, 256-entry %llu\n", (unsigned long long)cpi.ld_hit_pred, (unsigned long long)cpi.ld_way_miss,
+				(unsigned long long)cpi.taken_br, (unsigned long long)cpi.btb64_hit, (unsigned long long)cpi.btb256_hit);
+		std::fprintf(o, "\nhottest RAM PCs\n");
+		std::vector<std::pair<uint64_t, UINT32>> hot;
+		for (size_t i = 0; i < pc_ram.size(); i++)
+			if (pc_ram[i]) hot.emplace_back(pc_ram[i], UINT32(i * 4));
+		size_t n = std::min<size_t>(60, hot.size());
+		std::partial_sort(hot.begin(), hot.begin() + n, hot.end(), std::greater<>());
+		for (size_t i = 0; i < n; i++)
+			std::fprintf(o, "%08X %14llu %8.4f%%  %08X\n", hot[i].second, (unsigned long long)hot[i].first, 100.0 * hot[i].first / total, op_ram[hot[i].second >> 2]);
+		std::fclose(o);
+	}
+	inline void step(UINT32 pc, UINT32 op, UINT32 npc)
+	{
+		f_insn++;
+		if (pc < 0x800000)
+		{
+			pc_ram[pc >> 2]++;
+			op_ram[pc >> 2] = op;
+		}
+		else
+			f_rom++;
+		bool is_idle = false;
+		for (auto const &r : idle)
+			if (pc >= r.first && pc <= r.second) { f_idle++; is_idle = true; break; }
+		if (cpi.on)
+			cpi.step(pc, op, npc, is_idle);
+	}
+	void tick()
+	{
+		if (!on)
+			return;
+		std::fprintf(f, "%llu,%llu,%llu,%llu", (unsigned long long)frame, (unsigned long long)f_insn, (unsigned long long)f_idle, (unsigned long long)f_rom);
+		for (auto &c : cpi.cfg) { std::fprintf(f, ",%llu", (unsigned long long)(c.last - c.frame_start)); c.frame_start = c.last; }
+		cpi.flush_fpu();
+		for (auto &c : cpi.fcfg) { std::fprintf(f, ",%llu", (unsigned long long)(c.last - c.frame_start)); c.frame_start = c.last; }
+		std::fprintf(f, "\n");
+		fpc.frame();
+		total += f_insn;
+		f_insn = f_idle = f_rom = 0;
+		frame++;
+	}
+};
+m3cpu_census g_m3cpu;
+}
+
+void m3cpu_frame() { g_m3cpu.tick(); }
+
+static void m3cpu_mem(UINT32 address, unsigned size, bool write)
+{
+	if (g_m3cpu.cpi.on)
+		g_m3cpu.cpi.record(address, size, write);
+}
