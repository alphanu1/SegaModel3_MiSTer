# Standalone fit of the Real3D rasteriser front (slope divider and edge walker) at 50 MHz.
# Quartus Prime Lite 17.0.
set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CSEBA6U23I7
set_global_assignment -name TOP_LEVEL_ENTITY r3d_rast_front
set_global_assignment -name LAST_QUARTUS_VERSION "17.0.0 Lite Edition"
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name SDC_FILE r3d_rast_front.sdc
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/real3d/r3d_rast_div.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/real3d/r3d_rast_edge.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/real3d/r3d_rast_front.sv
set_global_assignment -name OPTIMIZATION_MODE "HIGH PERFORMANCE EFFORT"
set_global_assignment -name AUTO_SHIFT_REGISTER_RECOGNITION OFF
set_global_assignment -name NUM_PARALLEL_PROCESSORS 4
set_global_assignment -name SEED 1
set_instance_assignment -name VIRTUAL_PIN ON -to rst
set_instance_assignment -name VIRTUAL_PIN ON -to t_*
set_instance_assignment -name VIRTUAL_PIN ON -to s_*
set_instance_assignment -name VIRTUAL_PIN ON -to busy
