+     'P' pass, model, word_off, hdr[7], nv_in, nv_new, nv_clip, status,
+         clip_in[4][7] (x, y, z, w, p0, p1, p2 before clip)
+     'T' pass, alpha, buf_index, poly_seq, v[3][7] (x, y, z, w, p0, p1, p2
+         after clip, divide and viewport; p0/p1 are u/w, v/w), tex_en, page,
+         tex_x, tex_y, tex_w, tex_h, tex_fmt, param, transparency, color
