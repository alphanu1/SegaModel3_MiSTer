# Standalone fit of the Real3D geometry (walker to triangle list) at 100 MHz.
# Quartus Prime Lite 17.0. SETUP_CR = 1 (bit-exact set-up), CULL = 0 (MAME's walk),
# SUBNORM = 0 (flush-to-zero FP units). Seed sweeps: sm3-builds/r3d/fit.sh.
set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CSEBA6U23I7
set_global_assignment -name TOP_LEVEL_ENTITY r3d_geo
set_global_assignment -name LAST_QUARTUS_VERSION "17.0.0 Lite Edition"
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name SDC_FILE r3d_geo.sdc
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/real3d/r3d_ucode_pkg.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/real3d/r3d_ram.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/real3d/r3d_fp_mul.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/real3d/r3d_fp_add.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/real3d/r3d_recip.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/real3d/r3d_fsqrt.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/real3d/r3d_setup_cr.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/real3d/r3d_ucode.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/real3d/r3d_vpu.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/real3d/r3d_walker.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/real3d/r3d_mstream.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/real3d/r3d_geo.sv
set_global_assignment -name OPTIMIZATION_MODE "HIGH PERFORMANCE EFFORT"
# delay lines stay in registers: inferred shift-register RAM used 9 M10K for nothing
set_global_assignment -name AUTO_SHIFT_REGISTER_RECOGNITION OFF
set_global_assignment -name NUM_PARALLEL_PROCESSORS 4
set_global_assignment -name SEED 1
set_instance_assignment -name VIRTUAL_PIN ON -to rst
set_instance_assignment -name VIRTUAL_PIN ON -to start
set_instance_assignment -name VIRTUAL_PIN ON -to busy
set_instance_assignment -name VIRTUAL_PIN ON -to err*
set_instance_assignment -name VIRTUAL_PIN ON -to cull_*
set_instance_assignment -name VIRTUAL_PIN ON -to pram_*
set_instance_assignment -name VIRTUAL_PIN ON -to vrom_*
set_instance_assignment -name VIRTUAL_PIN ON -to tri_*
