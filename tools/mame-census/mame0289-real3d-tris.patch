+struct m3t_writer
+{
+	bool on = false;
+	std::string dir, name;
+	std::vector<uint32_t> buf;
+	size_t rec = 0;
+	uint32_t seq = 0, pass = 0, poly_seq = 0;
+	uint64_t polys = 0, vnew = 0, vreused = 0, bad0 = 0;
+	m3t_writer() { if (char const *const d = std::getenv("M3TRIS")) { on = true; dir = d; } }
+	void begin(char t) { rec = buf.size(); buf.push_back(uint32_t(t)); buf.push_back(0); }
+	void w(uint32_t x) { buf.push_back(x); }
+	void f(float x) { uint32_t u; std::memcpy(&u, &x, 4); buf.push_back(u); }
+	void end() { buf[rec + 1] = uint32_t(buf.size() - rec - 2); }
+	void frame_start(uint32_t step, uint64_t bad)
+	{
+		buf.clear(); poly_seq = 0; polys = vnew = vreused = 0; bad0 = bad;
+		begin('F'); w(seq); w(step); end();
+	}
+	void frame_end(uint64_t tris_o, uint64_t tris_a, uint64_t bad)
+	{
+		begin('E'); w(uint32_t(polys)); w(uint32_t(vnew)); w(uint32_t(vreused)); w(uint32_t(tris_o)); w(uint32_t(tris_a)); w(uint32_t(bad - bad0)); end();
+		std::string const fn = dir + "/" + (name.empty() ? std::to_string(seq) : name) + ".tri";
+		if (std::FILE *o = std::fopen(fn.c_str(), "wb")) { std::fwrite(buf.data(), 4, buf.size(), o); std::fclose(o); }
+		seq++;
+	}
+};
