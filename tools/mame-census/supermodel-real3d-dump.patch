+			else if (p == 59 || p == 63) r.xu = 2;
+			else if (p == 16 || p == 18 || (p == 19 && (x == 16 || x == 528))) r.xu = 4;
+			else if (p == 19 || p == 17 || (p == 31 && (x == 339 || x == 467 || x == 19 || x == 144 || x == 83 || x == 146 || x == 371 || x == 598 || x == 854 || x == 210 || x == 242 || x == 595 || x == 659 || x == 306 || x == 566 || x == 978 || x == 1010)))
