{
  // Several git repositories live under this workspace and only one of them is
  // this project. VS Code auto-detects every nested .git and lists them all in
  // Source Control, and the panel then switches between them, so another
  // project's history appears under this one.
  //
  //   sm3-builds/mame289-m3   MAME 0.289 clone carrying the census patch
  //                           (tools/mame-census). Measurement only.
  //   sm3-builds/mame289-r3d  MAME 0.289 clone with the census and triangle-list
  //                           patches (tools/mame-census). Measurement only.
  //   sm3-builds/supermodel   Supermodel clone, the Real3D reference.
  //   sm3-builds/supermodel-r3d  Supermodel clone with a finished-frame grab
  //                           (M3SHOT3D_LIST). Measurement only.
  //   sm3-builds/supermodel-tg   Supermodel clone with the tile generator dump
  //                           (M3TG_DIR). Measurement only.
  //   sm3-builds/mame289-tg   copy of mame289-m3 with the tile generator dump
  //                           (M3TG_DIR). Measurement only.
  //   sm3-builds/mame289-scripts   copy of mame289-m3 with the 53C810 capture
  //                           (M3SCRIPTS_LOG). Measurement only.
  //   sm3-builds/supermodel-scripts  Supermodel copy with the 53C810 capture
  //                           (M3SCRIPTS_LOG). Measurement only.
  //   sm3-builds/supermodel-sys  Supermodel clone with the tile dump and the
  //                           system bus trace (M3BUS_TRACE). Measurement only.
  //   sm3-builds/supermodel-sb   copy of supermodel-sys with the stage B Real3D
  //                           memory dumps and frame grabs (M3SB_DIR). Measurement only.
  //   sm3-builds/supermodel-snd  Supermodel clone with the sound board capture
  //                           (M3SND_DIR): MIDI writes and audio. Measurement only.
  //   sm3-builds/arcsnd   ppriest's MiSTer Arcade Sound Server, the base for the
  //                           Model 3 sound board on the HPS (D-51).
  //   tools/sloppc603-ref     SloPPC603, a GPL-2.0+ 603e core under review.
  //   tools/ddr3test-ref      Robert Peip's MiSTerDDR3Test, read for its DDR3 reader.
  //   tools/*-ref             read-only reference clones of other cores.
  //   third_party/*           upstream clones, never vendored.
  //
  // Listed explicitly as well as excluded from the scan, so opening a file in
  // one of them does not bring its repository back into Source Control.
  "git.ignoredRepositories": [
    "sm3-builds/mame289-m3",
    "sm3-builds/mame289-r3d",
    "sm3-builds/supermodel",
    "sm3-builds/supermodel-r3d",
    "sm3-builds/supermodel-tg",
    "sm3-builds/mame289-tg",
    "sm3-builds/mame289-scripts",
    "sm3-builds/supermodel-scripts",
    "sm3-builds/supermodel-sys",
    "sm3-builds/supermodel-sb",
    "sm3-builds/supermodel-snd",
    "sm3-builds/arcsnd",
    "tools/sloppc603-ref",
    "tools/ddr3test-ref"
  ],
  "git.repositoryScanIgnoredFolders": [
    "node_modules",
    "sm3-builds",
    "third_party",
    "build"
  ],

  // sm3-builds/ holds MAME and Supermodel trees, census output and build
  // worktrees: gigabytes the watcher has no reason to follow. Kept out of search
  // too; grep the MAME tree directly when it is the reference being read.
  "files.watcherExclude": {
    "**/sm3-builds/**": true,
    "**/third_party/**": true,
    "**/tools/*-ref/**": true,
    "**/obj_*/**": true,
    "**/db/**": true,
    "**/incremental_db/**": true,
    "**/output_files/**": true,
    "**/build/**": true
  },
  "search.exclude": {
    "**/sm3-builds/**": true
  },

  "[systemverilog]": {
    "editor.insertSpaces": true,
    "editor.tabSize": 2
  },
  "[verilog]": {
    "editor.insertSpaces": true,
    "editor.tabSize": 2
  },
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true
}
