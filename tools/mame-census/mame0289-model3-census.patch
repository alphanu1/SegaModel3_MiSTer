+void model3_state::m3b_replay_frame()
+{
+	static char const *const dir = std::getenv("M3REPLAY");
+	static std::vector<std::string> files;
+	static size_t next = 0;
+	static bool listed = false;
+	if (!dir)
+		return;
+	if (!listed)
+	{
+		for (auto const &e : std::filesystem::directory_iterator(dir))
+			if (e.path().extension() == ".gz")
+				files.push_back(e.path().string());
+		std::sort(files.begin(), files.end());
+		listed = true;
+		osd_printf_info("census replay: %u dumps from %s\n", unsigned(files.size()), dir);
+	}
+	if (next >= files.size())
+	{
+		machine().schedule_exit();
+		return;
+	}
+	// gzip file, inflated with the raw zlib API (MAME's zlib has no gz* functions)
+	std::FILE *fp = std::fopen(files[next++].c_str(), "rb");
+	if (!fp)
+		return;
+	std::vector<uint8_t> in;
+	uint8_t buf[65536];
+	size_t n;
+	while ((n = std::fread(buf, 1, sizeof(buf), fp)) > 0)
+		in.insert(in.end(), buf, buf + n);
+	std::fclose(fp);
+	std::vector<uint8_t> out(0x400000 + 0x100000 + 0x400000 + 0x800000);
+	z_stream z = {};
+	inflateInit2(&z, 16 + MAX_WBITS);
+	z.next_in = in.data();
+	z.avail_in = uInt(in.size());
+	z.next_out = out.data();
+	z.avail_out = uInt(out.size());
+	inflate(&z, Z_FINISH);
+	inflateEnd(&z);
+	uint8_t const *p = out.data();
+	std::memcpy(m_culling_ram.get(), p, 0x400000); p += 0x400000;
+	std::memcpy(m_display_list_ram.get(), p, 0x100000); p += 0x100000;
+	std::memcpy(m_polygon_ram.get(), p, 0x400000); p += 0x400000;
+	std::memcpy(m_texture_ram[0].get(), p, 0x400000); p += 0x400000;
+	std::memcpy(m_texture_ram[1].get(), p, 0x400000);
+	invalidate_texture(0, 0, 0, 6, 5);
+	invalidate_texture(1, 0, 0, 6, 5);
+	m_texture_fifo_pos = 0;
+	m3b_replaying = true;
+	real3d_display_list_end();
+	m3b_replaying = false;
+}
