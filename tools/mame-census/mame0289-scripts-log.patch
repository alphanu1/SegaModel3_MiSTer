 #define DMA_MAX_ICOUNT  512     /* Maximum number of DMA Scripts opcodes to run */
+
+// M0-F capture (M3SCRIPTS_LOG=path): register accesses, starts, instructions,
+// memory moves and interrupts, prefixed by frame and emulated time in us.
+static FILE *m3s_file()
+{
+	static FILE *f = nullptr;
+	static bool init = false;
+	if (!init) { init = true; if (const char *p = std::getenv("M3SCRIPTS_LOG")) f = std::fopen(p, "w"); }
+	return f;
+}
+running_machine *m3s_machine = nullptr;
+void m3s_log(const char *fmt, ...)
+{
+	FILE *f = m3s_file();
+	if (!f || !m3s_machine) return;
+	screen_device *scr = screen_device_enumerator(m3s_machine->root_device()).first();
+	std::fprintf(f, "%u %.3f ", scr ? unsigned(scr->frame_number()) : 0u, m3s_machine->time().as_double() * 1e6);
+	va_list ap; va_start(ap, fmt); std::vfprintf(f, fmt, ap); va_end(ap);
+	std::fflush(f);
+}
