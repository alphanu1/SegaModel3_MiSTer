+    {
+      gzwrite(f, cullingRAMLo, 0x400000);   // 8C000000, MAME m_culling_ram
+      gzwrite(f, cullingRAMHi, 0x100000);   // 8E000000, MAME m_display_list_ram
+      gzwrite(f, polyRAM, 0x400000);
+      gzwrite(f, textureRAM, 0x800000);     // 2048 x 2048, page 1 from row 1024
+      gzclose(f);
+    }
+  }
+  static const char *shotDir = std::getenv("M3SHOT_DIR");
+  static const int shotEvery = std::getenv("M3SHOT_EVERY") ? std::atoi(std::getenv("M3SHOT_EVERY")) : 600;
+  if (shotDir && frame % shotEvery == 0)
+  {
+    extern void M3Shot(const char *, int);
+    M3Shot(shotDir, frame);
+  }
+  extern void m3cpu_frame();
+  m3cpu_frame();
+  frame++;
+  if (stop && frame >= stop)
+    std::exit(0);
+  Render3D->RenderFrame();
 }
 
