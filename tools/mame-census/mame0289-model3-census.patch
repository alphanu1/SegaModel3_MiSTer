+
+
+/***************************************************************************
+    MODEL 3 CENSUS
+    Enabled by M3CENSUS=<output prefix>. Counts every executed instruction
+    by opcode, SPR traffic, MSR translation state, PC region and per-frame
+    I-cache line footprint, and checks whether double-precision FP results
+    are exactly representable in single precision.
+***************************************************************************/
+
+#include <cmath>
+#include <fstream>
+#include <map>
+
+struct ppc_device::census_state
+{
+	std::string prefix;
+	std::vector<uint64_t> op_count = std::vector<uint64_t>(65536);
+	std::vector<uint32_t> op_sample = std::vector<uint32_t>(65536);
+	std::map<uint32_t, std::pair<uint64_t, uint64_t>> fpd;  // key -> {checked, not single-exact}
+	uint64_t spr_read[1024] = {}, spr_write[1024] = {}, tbr_read[1024] = {};
+	uint64_t msr_irdr[4] = {};
+	uint32_t msr_or = 0, msr_and = ~0U;
+	uint64_t region_total[4] = {};
+	std::vector<uint64_t> pc_ram = std::vector<uint64_t>(0x800000 / 4);
+	std::vector<uint64_t> pc_crom = std::vector<uint64_t>(0x1000000 / 4);
+	std::vector<uint32_t> line_stamp = std::vector<uint32_t>(0x40000 + 0x80000);
+	uint32_t pending_key = 0, pending_d = 0;
+	uint32_t frame = 0;
+	uint64_t last_cycles = 0;
+	uint64_t f_insn = 0, f_region[4] = {}, f_lines[4] = {}, f_fps = 0, f_fpd = 0;
+	uint64_t max_lines = 0;
+	std::vector<std::pair<uint32_t, uint32_t>> idle;  // M3IDLE=lo-hi,... busy-wait PC ranges
+	uint64_t f_idle = 0;
+	std::ofstream frames;
+};
+
+static inline uint32_t census_key(uint32_t op)
+{
+	uint32_t const p = op >> 26;
+	uint32_t x = 0;
+	if (p == 19 || p == 31)
+		x = (op >> 1) & 0x3ff;
+	else if (p == 59)
+		x = (op >> 1) & 0x1f;
+	else if (p == 63)
+	{
+		uint32_t const x5 = (op >> 1) & 0x1f;
+		x = (x5 >= 18 && x5 != 19 && x5 != 24 && x5 != 27) ? (992 + x5) : ((op >> 1) & 0x3ff);
+	}
+	return p * 1024 + x;
+}
+
+void ppc_device::census_step()
+{
+	census_state &c = *m_census;
+	uint32_t const op = m_core->census_op;
+	uint32_t const pc = m_core->pc;
+
+	// the previous instruction has now executed: check its double result
+	if (c.pending_key)
+	{
+		double const v = m_core->f[c.pending_d];
+		auto &e = c.fpd[c.pending_key];
+		e.first++;
+		if (!std::isnan(v) && double(float(v)) != v)
+			e.second++;
+		c.pending_key = 0;
+	}
+
+	uint32_t const key = census_key(op);
+	if (c.op_count[key]++ == 0)
+		c.op_sample[key] = op;
+
+	uint32_t const p = op >> 26;
+	if (p == 59)
+		c.f_fps++;
+	else if (p == 63)
+	{
+		uint32_t const x5 = (op >> 1) & 0x1f;
+		if (x5 >= 18 && x5 != 19 && x5 != 24 && x5 != 27)
+		{
+			c.pending_key = key;
+			c.pending_d = (op >> 21) & 31;
+			c.f_fpd++;
+		}
+	}
+	else if (p == 31)
+	{
+		uint32_t const xo = (op >> 1) & 0x3ff;
+		uint32_t const spr = ((op >> 16) & 0x1f) | ((op >> 6) & 0x3e0);
+		if (xo == 339) c.spr_read[spr]++;
+		else if (xo == 467) c.spr_write[spr]++;
+		else if (xo == 371) c.tbr_read[spr]++;
+	}
+
+	uint32_t const msr = m_core->msr;
+	c.msr_or |= msr;
+	c.msr_and &= msr;
+	c.msr_irdr[(msr >> 4) & 3]++;
+
+	int r = 3;
+	int64_t line = -1;
+	if (pc < 0x800000)
+	{
+		r = 0;
+		c.pc_ram[pc >> 2]++;
+		line = pc >> 5;
+	}
+	else if (pc >= 0xff000000)
+	{
+		r = (pc >= 0xff800000) ? 1 : 2;
+		c.pc_crom[(pc - 0xff000000) >> 2]++;
+		line = 0x40000 + ((pc - 0xff000000) >> 5);
+	}
+	c.region_total[r]++;
+	c.f_region[r]++;
+	if (line >= 0 && c.line_stamp[line] != c.frame + 1)
+	{
+		c.line_stamp[line] = c.frame + 1;
+		c.f_lines[r]++;
+	}
+	for (auto const &r : c.idle)
+		if (pc >= r.first && pc <= r.second)
+		{
+			c.f_idle++;
+			break;
+		}
+	c.f_insn++;
+}
+
+void ppc_device::census_frame()
+{
+	if (!m_census)
+		return;
+	census_state &c = *m_census;
+	uint64_t const cyc = total_cycles();
+	uint64_t const lines = c.f_lines[0] + c.f_lines[1] + c.f_lines[2];
+	c.max_lines = std::max(c.max_lines, lines);
+	c.frames << c.frame << ',' << (cyc - c.last_cycles) << ',' << c.f_insn << ','
+			<< c.f_region[0] << ',' << c.f_region[1] << ',' << c.f_region[2] << ',' << c.f_region[3] << ','
+			<< c.f_lines[0] << ',' << c.f_lines[1] << ',' << c.f_lines[2] << ','
+			<< c.f_fps << ',' << c.f_fpd << ',' << c.f_idle << '\n';
+	c.last_cycles = cyc;
+	c.f_insn = c.f_fps = c.f_fpd = c.f_idle = 0;
+	std::fill(std::begin(c.f_region), std::end(c.f_region), 0);
+	std::fill(std::begin(c.f_lines), std::end(c.f_lines), 0);
+	c.frame++;
+}
+
+void ppc_device::census_dump()
+{
+	if (!m_census)
+		return;
+	census_state &c = *m_census;
+	c.frames.close();
+	std::ofstream o(c.prefix + ".txt");
+	auto dasm = [this](uint32_t pc, uint32_t op) { std::ostringstream s; m_dasm.dasm_one(s, pc, op); return s.str(); };
+
+	uint64_t total = 0;
+	for (auto n : c.op_count) total += n;
+	o << "frames " << c.frame << "\ninstructions " << total << "\n\n";
+
+	o << "== opcode classes by count (key, count, share, sample)\n";
+	std::vector<uint32_t> keys;
+	for (uint32_t k = 0; k < 65536; k++) if (c.op_count[k]) keys.push_back(k);
+	std::sort(keys.begin(), keys.end(), [&c](uint32_t a, uint32_t b) { return c.op_count[a] > c.op_count[b]; });
+	o << "distinct " << keys.size() << '\n';
+	for (auto k : keys)
+		o << util::string_format("%2u/%-4u %14u %8.4f%%  %08X  %s\n", k >> 10, k & 1023, c.op_count[k], 100.0 * c.op_count[k] / total, c.op_sample[k], dasm(0, c.op_sample[k]));
+
+	o << "\n== double-precision results (key, checked, not exactly single, sample)\n";
+	for (auto &e : c.fpd)
+		o << util::string_format("%2u/%-4u %14u %14u  %s\n", e.first >> 10, e.first & 1023, e.second.first, e.second.second, dasm(0, c.op_sample[e.first]));
+
+	o << "\n== SPR (number, mfspr, mtspr)\n";
+	for (int i = 0; i < 1024; i++)
+		if (c.spr_read[i] || c.spr_write[i])
+			o << util::string_format("%4d %14u %14u\n", i, c.spr_read[i], c.spr_write[i]);
+	o << "\n== TBR reads (mftb)\n";
+	for (int i = 0; i < 1024; i++)
+		if (c.tbr_read[i])
+			o << util::string_format("%4d %14u\n", i, c.tbr_read[i]);
+
+	o << util::string_format("\n== MSR  or %08X  and %08X\n", c.msr_or, c.msr_and);
+	o << util::string_format("IR=0 DR=0 %u\nIR=0 DR=1 %u\nIR=1 DR=0 %u\nIR=1 DR=1 %u\n", c.msr_irdr[0], c.msr_irdr[1], c.msr_irdr[2], c.msr_irdr[3]);
+
+	static const char *const rname[4] = { "RAM", "fixed CROM", "banked CROM", "other" };
+	o << "\n== PC regions (instructions, distinct words, footprint KiB)\n";
+	for (int r = 0; r < 4; r++)
+	{
+		uint64_t words = 0;
+		if (r == 0) for (auto n : c.pc_ram) words += n != 0;
+		if (r == 1) for (size_t i = 0x800000 / 4; i < c.pc_crom.size(); i++) words += c.pc_crom[i] != 0;
+		if (r == 2) for (size_t i = 0; i < 0x800000 / 4; i++) words += c.pc_crom[i] != 0;
+		o << util::string_format("%-12s %14u %10u %8.1f\n", rname[r], c.region_total[r], words, words * 4 / 1024.0);
+	}
+	o << "max distinct 32-byte I-lines in one frame " << c.max_lines << " (" << c.max_lines * 32 / 1024.0 << " KiB)\n";
+
+	o << "\n== hottest PCs\n";
+	std::vector<std::pair<uint64_t, uint32_t>> hot;
+	for (size_t i = 0; i < c.pc_ram.size(); i++) if (c.pc_ram[i]) hot.emplace_back(c.pc_ram[i], uint32_t(i * 4));
+	for (size_t i = 0; i < c.pc_crom.size(); i++) if (c.pc_crom[i]) hot.emplace_back(c.pc_crom[i], uint32_t(0xff000000 + i * 4));
+	std::partial_sort(hot.begin(), hot.begin() + std::min<size_t>(60, hot.size()), hot.end(), std::greater<>());
+	for (size_t i = 0; i < std::min<size_t>(60, hot.size()); i++)
+	{
+		uint32_t const pc = hot[i].second;
+		o << util::string_format("%08X %14u %8.4f%%  %s\n", pc, hot[i].first, 100.0 * hot[i].first / total, dasm(pc, m_program->read_dword(pc)));
+	}
+
+	delete m_census;
+	m_census = nullptr;
+}
+
+void ppc_device::census_init()
+{
+	if (char const *const prefix = getenv("M3CENSUS"))
+	{
+		m_census = new census_state;
+		m_census->prefix = prefix;
+		m_census->frames.open(m_census->prefix + "_frames.csv");
+		m_census->frames << "frame,cycles,insn,ram,fixed_crom,banked_crom,other,lines_ram,lines_fixed,lines_banked,fp_single,fp_double,idle\n";
+		if (char const *const idle = getenv("M3IDLE"))
+		{
+			std::istringstream in(idle);
+			std::string range;
+			while (std::getline(in, range, ','))
+			{
+				auto const dash = range.find('-');
+				m_census->idle.emplace_back(std::stoul(range.substr(0, dash), nullptr, 16), std::stoul(range.substr(dash + 1), nullptr, 16));
+			}
+		}
+	}
+}
