# Standalone fit of Model 3's two SCSPs (rtl/sound/scsp/scsp_pair.sv) at 100 MHz.
# Quartus Prime Lite 17.0. SCSP_SHARED 1: one engine for both chips (scsp_dual);
# 0: two m2_scsp with a 2:1 arbiter on each memory port. Every port but clk is a
# virtual pin; the per-entity figures exclude the pins' ALMs.
set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CSEBA6U23I7
set_global_assignment -name TOP_LEVEL_ENTITY scsp_pair
set_global_assignment -name LAST_QUARTUS_VERSION "17.0.0 Lite Edition"
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name SDC_FILE scsp_pair.sdc
set_global_assignment -name SEARCH_PATH ../../rtl/sound/scsp
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/sound/scsp/m2_scsp_cache.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/sound/scsp/m2_scsp_level.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/sound/scsp/m2_scsp_regs.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/sound/scsp/m2_scsp_dsp.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/sound/scsp/m2_scsp.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/sound/scsp/scsp_dual_dsp.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/sound/scsp/scsp_dual.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/sound/scsp/scsp_pair.sv
set_global_assignment -name OPTIMIZATION_MODE "HIGH PERFORMANCE EFFORT"
set_global_assignment -name AUTO_SHIFT_REGISTER_RECOGNITION OFF
set_global_assignment -name NUM_PARALLEL_PROCESSORS 4
set_global_assignment -name SEED 1
set_parameter -name SCSP_SHARED 1
set_instance_assignment -name VIRTUAL_PIN ON -to rst_n
set_instance_assignment -name VIRTUAL_PIN ON -to cpu_*
set_instance_assignment -name VIRTUAL_PIN ON -to ipl*
set_instance_assignment -name VIRTUAL_PIN ON -to midi_*
set_instance_assignment -name VIRTUAL_PIN ON -to mout_*
set_instance_assignment -name VIRTUAL_PIN ON -to sm_*
set_instance_assignment -name VIRTUAL_PIN ON -to dm_*
set_instance_assignment -name VIRTUAL_PIN ON -to snp*
set_instance_assignment -name VIRTUAL_PIN ON -to out_*
set_instance_assignment -name VIRTUAL_PIN ON -to tick44
set_instance_assignment -name VIRTUAL_PIN ON -to tph*
set_instance_assignment -name VIRTUAL_PIN ON -to cpu_tick
set_instance_assignment -name VIRTUAL_PIN ON -to tarc
set_instance_assignment -name VIRTUAL_PIN ON -to boost*
