+void CTileGen::M3TgBegin(void)
+{
+	m_tgVramCopy.assign(m_vram, m_vram + 0x120000);
+	std::memcpy(m_tgRegsCopy, m_regs, sizeof(m_tgRegsCopy));
+}
+
+void CTileGen::M3TgEnd(const char *base)
+{
+	char name[600];
+	std::snprintf(name, sizeof(name), "%s.vram", base);
+	if (FILE *f = std::fopen(name, "wb")) { std::fwrite(m_tgVramCopy.data(), 1, 0x120000, f); std::fclose(f); }
+	std::snprintf(name, sizeof(name), "%s.regs", base);
+	if (FILE *f = std::fopen(name, "wb")) { std::fwrite(m_tgRegsCopy, 1, 0x100, f); std::fclose(f); }
+	std::snprintf(name, sizeof(name), "%s.surf", base);
+	if (FILE *f = std::fopen(name, "wb")) {
+		std::fwrite(m_drawSurface[0]->data, 4, 512 * 384, f);
+		std::fwrite(m_drawSurface[1]->data, 4, 512 * 384, f);
+		std::fclose(f);
+	}
+	bool vramChanged = std::memcmp(m_tgVramCopy.data(), m_vram, 0x120000) != 0;
+	bool regsChanged = std::memcmp(m_tgRegsCopy, m_regs, 0x100) != 0;
+	std::snprintf(name, sizeof(name), "%s.info", base);
+	if (FILE *f = std::fopen(name, "w")) { std::fprintf(f, "vram_changed %d\nregs_changed %d\n", vramChanged, regsChanged); std::fclose(f); }
+}
