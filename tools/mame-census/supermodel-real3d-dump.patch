+/*
+ * Model 3 census: M3CPU=<prefix> counts every executed instruction, per frame,
+ * with M3IDLE=lo-hi,... busy-wait PC ranges counted separately. Run with
+ * -no-idle-skip so the wait loops are executed rather than skipped.
+ */
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <string>
+#include <vector>
+#include <algorithm>
+#include <thread>
+#include "m3fp_census.h"
+#include "PPCDisasm.h"
+
+namespace {
+
+/*
+ * CPI model for a scalar in-order 603e at 100 MHz (M3CPI=1 with M3CPU). Fed the busy
+ * instruction stream with its load/store addresses: a register scoreboard with
+ * load-use, multiply, divide and FP latencies, static branch prediction, 4-way
+ * instruction and data caches with 32-byte lines (blocking, write-back), uncached
+ * MMIO with posted stores. Several cache sizes and miss penalties run side by side.
+ */
+struct m3cpi_cache
+{
+	int ways, sets;
+	std::vector<UINT32> tag;
+	std::vector<uint8_t> dirty;
+	std::vector<uint32_t> age;
+	uint32_t clk = 0;
+	m3cpi_cache(int kib, int w) : ways(w), sets(kib * 1024 / 32 / w), tag(sets * w, ~0u), dirty(sets * w, 0), age(sets * w, 0) {}
+	int access(UINT32 addr, bool write, int *way_miss = nullptr)	// 0 hit, 1 miss, 2 miss with dirty victim
+	{
+		UINT32 const line = addr >> 5;
+		int const set = line % sets;
+		UINT32 *t = &tag[set * ways];
+		uint32_t *a = &age[set * ways];
+		uint8_t *d = &dirty[set * ways];
+		clk++;
+		int victim = 0;
+		for (int w = 0; w < ways; w++)
+		{
+			if (t[w] == line)
+			{
+				if (way_miss)	// way prediction: the most recently used way of the set
+				{
+					int mru = 0;
+					for (int v = 1; v < ways; v++) if (a[v] > a[mru]) mru = v;
+					*way_miss = w != mru;
+				}
+				a[w] = clk; d[w] |= write; return 0;
+			}
+			if (a[w] < a[victim]) victim = w;
+		}
+		int const r = d[victim] ? 2 : 1;
+		t[victim] = line; a[victim] = clk; d[victim] = write;
+		return r;
+	}
+};
+
+struct m3cpi_config
+{
+	const char *name;
+	int penalty;			// line fill, cycles
+	int stall;			// cycles a load or fetch miss waits (early restart: first word)
+	bool storebuf;			// store misses and castouts go through a write buffer
+	m3cpi_cache ic, dc;
+	uint64_t last = 0, ready[72] = {}, fpu_free = 0, div_free = 0, frame_start = 0;
+	int pending_bubbles = 0;
+	m3cpi_config(const char *n, int kib, int pen, int st = -1, bool sb = false) : name(n), penalty(pen), stall(st < 0 ? pen : st), storebuf(sb), ic(kib, 4), dc(kib, 4) {}
+};
+
+/*
+ * FPU sweep (M3CPI_FPU=1): FPU latency options on one shared 16 KiB 4-way I and D cache
+ * pair with store buffer and early restart, at several CPU clocks. Cache contents do not
+ * depend on timing, so hit and miss are computed once per instruction; each option keeps
+ * only its own scoreboard. FP sources and destinations are decoded exactly here.
+ */
+enum { FC_NONE, FC_S_ADD, FC_S_MUL, FC_S_FMA, FC_D_ADD, FC_D_MUL, FC_D_FMA, FC_FDIVS, FC_FDIV, FC_FRES, FC_FRSQRTE,
+	FC_FSEL, FC_MOVE, FC_RND, FC_CMP, FC_FPSCR, FC_N };
+enum { FU_PIPE = 1, FU_DIV = 3 };
+
+struct m3cpi_fpu
+{
+	struct { int lat, busy, unit; } c[FC_N];
+	bool serial = false;		// fcmpu/fcmpo, mffs, mtfsf(i), mtfsb0/1, mcrfs wait for the FP pipeline to drain
+	bool div_blocks = false;	// the iterative unit also stalls the FMA pipeline
+	bool serial_fpscr = false;	// mffs, mtfsf(i), mtfsb0/1, mcrfs wait for the FP pipeline to drain
+	int idiv = 0;			// integer divide latency override (0: the decode's 20)
+	bool dual = false;		// 603e dispatch: two instructions a cycle to different units
+	bool ld1b = false;		// built loads: load-use 3, a hit in the non-predicted (not most recently
+					// used) way +2 cycles, FP loads hold WB one cycle
+	bool load2 = false;		// load hit holds MEM a second cycle: +1 cycle per word loaded, load-use +1
+	bool icbuilt = false;		// built I-cache: taken-branch redirect 2 cycles, sequential new line +1,
+					// first word of a miss L+4 (D) and L+3 (I) with L = 12 at 120 MHz
+	bool ld_use2 = false;		// with ld1b: keep the way-miss and FP-load costs but load use 2, not 3
+	int redirect = 2;		// built I-side (icbuilt): cycles lost on a correctly predicted taken branch
+	int btb = 0;			// 64 or 256: a direct-mapped BTB hit makes that redirect free
+	int nl_cost = 1, wm_cost = 2;	// sequential new line; load hit outside the predicted way (ld1b)
+	int dual_mode = 0;
+	bool fast_wb = false;		// single ops and frsqrte on a fast path: may issue only when no FP pipeline
+					// result is due at t + fast latency or later (in-order write-back)
+	int fast_lat = 0;		// with dual: 0 any two different units, 2 an FP op with a non-FP op
+	bool fold = false;		// 603e branch folding (User's Manual 6.4.1.1): a branch takes no
+					// dispatch slot and a taken branch hitting in the cache costs nothing;
+					// a misprediction refetches 2 cycles after the CR is ready, and
+					// bclr/bcctr wait for LR/CTR
+};
+
+struct m3cpi_fcfg
+{
+	std::string name;
+	m3cpi_fpu fpu;
+	int stall, io_load, io_store;
+	int ist = 15, dst = 16;		// built caches: first word of an I / D miss (L + 3, L + 4)
+	uint64_t last = 0, ready[72] = {}, fpu_free = 0, fdiv_free = 0, div_free = 0, drain = 0, frame_start = 0;
+	int pending_bubbles = 0;
+	int slot = 0, last_xu = -1;	// dual dispatch: instructions issued at cycle 'last', unit of the first
+	uint64_t min_next = 0;		// folded branches: earliest issue of the next instruction
+	uint64_t pipe_due = 0;		// latest result due from the FP pipeline (fast_wb)
+	bool last_pairable = false, last_fpop = false;
+};
+
+enum { R_CR = 64, R_LR, R_CTR, R_NONE = 127 };
+
+struct m3cpi_decoded
+{
+	int src[4] = { R_NONE, R_NONE, R_NONE, R_NONE };
+	int dst[3] = { R_NONE, R_NONE, R_NONE };
+	int lat = 1;			// result latency
+	int busy = 0;			// cycles the FP or divide unit stays occupied
+	int unit = 0;			// 1 FPU, 2 divider
+	int extra = 0;			// extra issue cycles (lmw/stmw, sync, rfi)
+	int is_load = 0;
+	int fclass = FC_NONE;		// FPU sweep only
+};
+
+// exact FP operands and class for the FPU sweep (the R22 configurations keep m3cpi_decode)
+static inline void m3cpi_decode_fp(UINT32 op, m3cpi_decoded &d)
+{
+	int const p = op >> 26, rd = (op >> 21) & 31, ra = (op >> 16) & 31, rb = (op >> 11) & 31, rc = (op >> 6) & 31;
+	int const xo10 = (op >> 1) & 0x3ff, xo5 = (op >> 1) & 0x1f;
+	if (p != 59 && p != 63) return;
+	for (int &s : d.src) s = R_NONE;
+	for (int &x : d.dst) x = R_NONE;
+	d.unit = 1;
+	int const A = 32 + ra, B = 32 + rb, C = 32 + rc, D = 32 + rd;
+	auto src = [&](int a, int b = R_NONE, int c = R_NONE) { d.src[0] = a; d.src[1] = b; d.src[2] = c; };
+	int cls = FC_NONE;
+	if (p == 59 || (xo5 >= 18 && xo5 != 19 && xo5 != 24 && xo5 != 27))
+	{
+		bool const s = p == 59;
+		d.dst[0] = D;
+		switch (xo5)
+		{
+		case 18: src(A, B); cls = s ? FC_FDIVS : FC_FDIV; break;
+		case 20: case 21: src(A, B); cls = s ? FC_S_ADD : FC_D_ADD; break;
+		case 22: src(B); cls = s ? FC_FDIVS : FC_FDIV; break;		// fsqrt(s), not on the 603e
+		case 23: src(A, C, B); cls = FC_FSEL; break;
+		case 24: src(B); cls = FC_FRES; break;
+		case 25: src(A, C); cls = s ? FC_S_MUL : FC_D_MUL; break;
+		case 26: src(B); cls = FC_FRSQRTE; break;
+		default: src(A, C, B); cls = s ? FC_S_FMA : FC_D_FMA; break;
+		}
+	}
+	else
+		switch (xo10)
+		{
+		case 0: case 32: src(A, B); d.dst[0] = R_CR; cls = FC_CMP; break;
+		case 12: case 14: case 15: src(B); d.dst[0] = D; cls = FC_RND; break;
+		case 583: d.dst[0] = D; cls = FC_FPSCR; break;
+		case 711: src(B); cls = FC_FPSCR; break;
+		case 64: d.dst[0] = R_CR; cls = FC_FPSCR; break;
+		case 134: case 70: case 38: cls = FC_FPSCR; break;
+		default: src(B); d.dst[0] = D; cls = FC_MOVE; break;	// fmr, fneg, fabs, fnabs
+		}
+	if ((op & 1) && d.dst[0] != R_CR) d.dst[1] = R_CR;
+	d.fclass = cls;
+}
+
+static inline void m3cpi_decode(UINT32 op, m3cpi_decoded &d)
+{
+	int const p = op >> 26, rd = (op >> 21) & 31, ra = (op >> 16) & 31, rb = (op >> 11) & 31, rc = (op >> 6) & 31;
+	int const xo10 = (op >> 1) & 0x3ff, xo5 = (op >> 1) & 0x1f;
+	bool const rcbit = op & 1;
+	auto S = [&](int i, int r) { d.src[i] = r; };
+	auto D = [&](int i, int r) { d.dst[i] = r; };
+	switch (p)
+	{
+	case 7: S(0, ra); D(0, rd); d.lat = 3; break;					// mulli
+	case 8: case 12: S(0, ra); D(0, rd); break;
+	case 13: S(0, ra); D(0, rd); D(1, R_CR); break;
+	case 14: case 15: if (ra) S(0, ra); D(0, rd); break;
+	case 10: case 11: S(0, ra); D(0, R_CR); break;
+	case 24: case 25: case 26: case 27: S(0, rd); D(0, ra); break;
+	case 28: case 29: S(0, rd); D(0, ra); D(1, R_CR); break;
+	case 20: S(0, rd); S(1, ra); D(0, ra); if (rcbit) D(1, R_CR); break;
+	case 21: S(0, rd); D(0, ra); if (rcbit) D(1, R_CR); break;
+	case 23: S(0, rd); S(1, rb); D(0, ra); if (rcbit) D(1, R_CR); break;
+	case 16: S(0, R_CR); S(1, R_CTR); if (!(rd & 4)) D(0, R_CTR); if (op & 1) D(1, R_LR); break;
+	case 18: if (op & 1) D(0, R_LR); break;
+	case 17: d.extra = 4; break;
+	case 19:
+		if (xo10 == 16) { S(0, R_LR); S(1, R_CR); S(2, R_CTR); if (op & 1) D(0, R_LR); }
+		else if (xo10 == 528) { S(0, R_CTR); S(1, R_CR); if (op & 1) D(0, R_LR); }
+		else if (xo10 == 50) d.extra = 4;			// rfi
+		else if (xo10 == 150) d.extra = 2;			// isync
+		else { S(0, R_CR); D(0, R_CR); }
+		break;
+	case 32: case 34: case 40: case 42: if (ra) S(0, ra); D(0, rd); d.lat = 2; d.is_load = 1; break;
+	case 33: case 35: case 41: case 43: S(0, ra); D(0, rd); D(1, ra); d.lat = 2; d.is_load = 1; break;
+	case 46: if (ra) S(0, ra); d.extra = 31 - rd; D(0, rd); d.lat = 2; d.is_load = 1; break;
+	case 36: case 38: case 44: S(0, rd); if (ra) S(1, ra); break;
+	case 37: case 39: case 45: S(0, rd); S(1, ra); D(0, ra); break;
+	case 47: S(0, rd); if (ra) S(1, ra); d.extra = 31 - rd; break;
+	case 48: case 50: if (ra) S(0, ra); D(0, 32 + rd); d.lat = 2; d.is_load = 1; break;
+	case 49: case 51: S(0, ra); D(0, 32 + rd); D(1, ra); d.lat = 2; d.is_load = 1; break;
+	case 52: case 54: S(0, 32 + rd); if (ra) S(1, ra); break;
+	case 53: case 55: S(0, 32 + rd); S(1, ra); D(0, ra); break;
+	case 31:
+		switch (xo10)
+		{
+		case 23: case 87: case 279: case 343: case 534: case 790: case 20:
+			if (ra) S(0, ra); S(1, rb); D(0, rd); d.lat = 2; d.is_load = 1; break;
+		case 55: case 119: case 311: case 375:
+			S(0, ra); S(1, rb); D(0, rd); D(1, ra); d.lat = 2; d.is_load = 1; break;
+		case 535: case 599: if (ra) S(0, ra); S(1, rb); D(0, 32 + rd); d.lat = 2; d.is_load = 1; break;
+		case 567: case 631: S(0, ra); S(1, rb); D(0, 32 + rd); D(1, ra); d.lat = 2; d.is_load = 1; break;
+		case 151: case 215: case 407: case 662: case 918: case 150:
+			S(0, rd); if (ra) S(1, ra); S(2, rb); if (xo10 == 150) D(0, R_CR); break;
+		case 183: case 247: case 439: S(0, rd); S(1, ra); S(2, rb); D(0, ra); break;
+		case 663: case 727: case 983: S(0, 32 + rd); if (ra) S(1, ra); S(2, rb); break;
+		case 695: case 759: S(0, 32 + rd); S(1, ra); S(2, rb); D(0, ra); break;
+		case 28: case 60: case 124: case 284: case 316: case 412: case 444: case 476: case 24: case 536: case 792:
+			S(0, rd); S(1, rb); D(0, ra); if (rcbit) D(1, R_CR); break;
+		case 824: case 26: case 922: case 954: S(0, rd); D(0, ra); if (rcbit) D(1, R_CR); break;
+		case 0: case 32: S(0, ra); S(1, rb); D(0, R_CR); break;
+		case 339: case 371: D(0, rd); { int spr = ((op >> 16) & 31) | ((op >> 6) & 0x3e0); if (spr == 8) S(0, R_LR); if (spr == 9) S(0, R_CTR); } break;
+		case 467: S(0, rd); { int spr = ((op >> 16) & 31) | ((op >> 6) & 0x3e0); if (spr == 8) D(0, R_LR); if (spr == 9) D(0, R_CTR); } break;
+		case 19: S(0, R_CR); D(0, rd); break;
+		case 144: S(0, rd); D(0, R_CR); break;
+		case 83: D(0, rd); break;
+		case 146: S(0, rd); d.extra = 2; break;
+		case 235: case 75: case 11: S(0, ra); S(1, rb); D(0, rd); d.lat = 3; if (rcbit) D(1, R_CR); break;
+		case 491: case 459: S(0, ra); S(1, rb); D(0, rd); d.lat = 20; d.busy = 19; d.unit = 2; if (rcbit) D(1, R_CR); break;
+		case 598: case 854: d.extra = 2; break;	// sync, eieio
+		default: S(0, ra); S(1, rb); D(0, rd); if (rcbit) D(1, R_CR); break;
+		}
+		break;
+	case 59:	// single precision
+		S(0, 32 + ra); S(1, 32 + rb); S(2, 32 + rc); D(0, 32 + rd); d.unit = 1;
+		if (xo5 == 18) { d.lat = 18; d.busy = 17; } else d.lat = 3;
+		if (rcbit) D(1, R_CR);
+		break;
+	case 63:	// double precision and FP moves/compares
+		S(0, 32 + ra); S(1, 32 + rb); S(2, 32 + rc); d.unit = 1;
+		if (xo5 >= 18 && xo5 != 19 && xo5 != 24 && xo5 != 27)
+		{
+			D(0, 32 + rd);
+			if (xo5 == 18) { d.lat = 33; d.busy = 32; }
+			else if (xo5 == 25 || xo5 >= 28) { d.lat = 9; d.busy = 8; }	// iterated through the single multiplier
+			else if (xo5 == 26) d.lat = 3;
+			else d.lat = 4;
+		}
+		else if (xo10 == 0 || xo10 == 32 || xo10 == 64) { D(0, R_CR); d.lat = 2; }
+		else { D(0, 32 + rd); d.lat = 2; }
+		if (rcbit) D(1, R_CR);
+		break;
+	default: break;
+	}
+}
+
+struct m3cpi_model
+{
+	bool on = false;
+	std::vector<m3cpi_config> cfg;
+	std::vector<m3cpi_fcfg> fcfg;
+	m3cpi_cache sic = m3cpi_cache(16, 4), sdc = m3cpi_cache(16, 4);
+	struct memop { UINT32 addr; unsigned size; bool write; };
+	memop mem[128];
+	int nmem = 0;
+	UINT32 prev_pc = 0, prev_op = 0, prev_npc = 0;
+	bool have_prev = false;
+
+	void init()
+	{
+		on = true;
+		cfg.emplace_back("perfect", 32, 0);
+		cfg.emplace_back("16k_p24", 16, 24);
+		cfg.emplace_back("16k_p24_sb", 16, 24, 24, true);
+		cfg.emplace_back("16k_p24_er12_sb", 16, 24, 12, true);
+		cfg.emplace_back("32k_p24_er12_sb", 32, 24, 12, true);
+		cfg.emplace_back("16k_p40_er20_sb", 16, 40, 20, true);
+		cfg.emplace_back("32k_p40_er20_sb", 32, 40, 20, true);
+		if (std::getenv("M3CPI_FPU"))
+			init_fpu();
+	}
+
+	/*
+	 * Latencies in CPU cycles. Clock options scale the memory-side costs (first word of a
+	 * 24-cycle fill, 12 at 100 MHz; uncached load 20) by the clock ratio, rounded up; posted
+	 * uncached stores stay 2. FP latencies stay in cycles.
+	 */
+	void init_fpu()
+	{
+		auto set = [](m3cpi_fpu &f, int cls, int lat, int busy, int unit = FU_PIPE) { f.c[cls].lat = lat; f.c[cls].busy = busy; f.c[cls].unit = unit; };
+		std::vector<std::pair<std::string, m3cpi_fpu>> opts;
+		{	// R22 latencies on exact FP operands
+			m3cpi_fpu f{};
+			for (int c : { FC_S_ADD, FC_S_MUL, FC_S_FMA, FC_FRES, FC_FRSQRTE }) set(f, c, 3, 0);
+			set(f, FC_D_ADD, 4, 0); set(f, FC_FSEL, 4, 0);
+			set(f, FC_D_MUL, 9, 8); set(f, FC_D_FMA, 9, 8);
+			set(f, FC_FDIVS, 18, 17); set(f, FC_FDIV, 33, 32);
+			for (int c : { FC_MOVE, FC_RND, FC_CMP, FC_FPSCR }) set(f, c, 2, 0);
+			opts.emplace_back("base", f);
+		}
+		struct divset { const char *n; int s, d, r, q; } const divs[2] = { { "r2", 28, 57, 28, 115 }, { "r4", 16, 30, 16, 60 } };
+		auto unified = [&](int L, divset const &dv, bool blocking, bool serial, bool div_blocks) {
+			m3cpi_fpu f{};
+			int const b = blocking ? L - 1 : 0;
+			for (int c : { FC_S_ADD, FC_S_MUL, FC_S_FMA, FC_D_ADD, FC_D_MUL, FC_D_FMA, FC_RND }) set(f, c, L, b);
+			for (int c : { FC_FSEL, FC_MOVE, FC_CMP, FC_FPSCR }) set(f, c, 2, blocking ? 1 : 0);
+			int const du = (blocking || div_blocks) ? FU_PIPE : FU_DIV;
+			set(f, FC_FDIVS, dv.s, dv.s - 1, du); set(f, FC_FDIV, dv.d, dv.d - 1, du);
+			set(f, FC_FRES, dv.r, dv.r - 1, du); set(f, FC_FRSQRTE, dv.q, dv.q - 1, du);
+			f.serial = serial; f.div_blocks = div_blocks;
+			return f;
+		};
+		for (auto const &dv : divs)
+			for (int L = 4; L <= 7; L++)
+				opts.emplace_back("u" + std::to_string(L) + "_" + dv.n, unified(L, dv, false, false, false));
+		for (auto const &dv : divs)
+			for (int L = 4; L <= 6; L++)
+				opts.emplace_back("blk" + std::to_string(L) + "_" + dv.n, unified(L, dv, true, false, false));
+		for (auto const &dv : divs)
+			for (int L = 5; L <= 6; L++)
+				opts.emplace_back("u" + std::to_string(L) + "_" + dv.n + "_ser", unified(L, dv, false, true, false));
+		opts.emplace_back("u5_r2_divblk", unified(5, divs[0], false, false, true));
+		for (int L = 4; L <= 6; L++)
+		{	// fres and frsqrte as pipelined table estimates (latency L), divides iterative radix 2
+			m3cpi_fpu f = unified(L, divs[0], false, false, false);
+			set(f, FC_FRES, L, 0); set(f, FC_FRSQRTE, L, 0);
+			opts.emplace_back("u" + std::to_string(L) + "_r2_est", f);
+		}
+		{	// the built FPU: pipelined FMA at L; divider from start to result fdiv 38, fdivs 24,
+			// fres 24, frsqrte 97, each blocking the divider (special-operand early outs not modelled)
+			divset const built = { "built", 24, 38, 24, 97 };
+			for (int L : { 12, 8 })
+				opts.emplace_back("meas_l" + std::to_string(L), unified(L, built, false, false, false));
+			m3cpi_fpu f = unified(12, built, false, false, false);
+			set(f, FC_FRSQRTE, 24, 23, FU_DIV);
+			opts.emplace_back("meas_l12_rsq24", f);
+		}
+		{	// the real 603e at 66 MHz: three-stage FPU, singles and double adds 1-1-1, double
+			// multiplies 2-1-1, fdivs and fres 18 and fdiv 33 blocking the FPU, frsqrte 3 pipelined,
+			// FPSCR instructions serialised, divw 37. ref66: memory costs scaled from 100 MHz
+			// (same time in ns); ref66_slow: the 100 MHz cycle counts kept (memory 1.5x slower)
+			m3cpi_fpu f{};
+			for (int c : { FC_S_ADD, FC_S_MUL, FC_S_FMA, FC_D_ADD, FC_FRSQRTE, FC_FSEL, FC_MOVE, FC_RND, FC_CMP, FC_FPSCR }) set(f, c, 3, 0);
+			set(f, FC_D_MUL, 4, 2); set(f, FC_D_FMA, 4, 2);
+			set(f, FC_FDIVS, 18, 17); set(f, FC_FRES, 18, 17); set(f, FC_FDIV, 33, 32);
+			f.serial_fpscr = true; f.idiv = 37;
+			opts.emplace_back("ref66", f);
+			opts.emplace_back("ref66_slow", f);
+			f.dual = true;
+			opts.emplace_back("ref66_dual", f);
+			opts.emplace_back("ref66_dual_slow", f);
+			f.fold = true;
+			opts.emplace_back("ref66_dual_ic", f);
+			opts.emplace_back("ref66_dual_ic_slow", f);
+		}
+		{	// split latencies at 120 MHz: single ops (primary opcode 59) Ls pipelined; double
+			// arithmetic, frsp and fctiw Ld, pipelined (12) or issuing every Ld cycles (16n);
+			// built divider (fdiv 38, fdivs 24, fres 24); frsqrte 97 or 24 on the divider, or an
+			// Ls pipelined estimate
+			for (int Ls : { 4, 6, 8 })
+				for (int dn = 0; dn < 2; dn++)
+					for (int q = 0; q < 3; q++)
+					{
+						int const Ld = dn ? 16 : 12;
+						m3cpi_fpu f{};
+						for (int c : { FC_S_ADD, FC_S_MUL, FC_S_FMA }) set(f, c, Ls, 0);
+						for (int c : { FC_D_ADD, FC_D_MUL, FC_D_FMA, FC_RND }) set(f, c, Ld, dn ? Ld : 0);
+						for (int c : { FC_FSEL, FC_MOVE, FC_CMP, FC_FPSCR }) set(f, c, 2, 0);
+						set(f, FC_FDIVS, 24, 23, FU_DIV); set(f, FC_FDIV, 38, 37, FU_DIV); set(f, FC_FRES, 24, 23, FU_DIV);
+						if (q == 0) set(f, FC_FRSQRTE, 97, 96, FU_DIV);
+						else if (q == 1) set(f, FC_FRSQRTE, 24, 23, FU_DIV);
+						else set(f, FC_FRSQRTE, Ls, 0);
+						opts.emplace_back("sp_s" + std::to_string(Ls) + "_d" + std::to_string(Ld) + (dn ? "n" : "") + (q == 0 ? "_q97" : q == 1 ? "_q24" : "_qest"), f);
+					}
+		}
+		{	// frsqrte latency sweep at 120 MHz: unified FMA L = 12, built divider, frsqrte blocking
+			// the divider at Q cycles
+			divset const built = { "built", 24, 38, 24, 97 };
+			for (int Q : { 24, 36, 48, 60, 72, 84, 97 })
+			{
+				m3cpi_fpu f = unified(12, built, false, false, false);
+				set(f, FC_FRSQRTE, Q, Q - 1, FU_DIV);
+				opts.emplace_back("rsq_l12_q" + std::to_string(Q), f);
+			}
+			// decision grid: built I-side costs; FPU unified 12, or singles 4/6 with doubles 12
