+			else r.xu = 0;
+			r.ld = d.is_load ? (p == 46 ? 32 - ((op >> 21) & 31) : 1) : 0;
+			r.wmiss = std::min(way_miss, 255);
+			r.fpld = (p >= 48 && p <= 51) || (p == 31 && (x == 535 || x == 567 || x == 599 || x == 631));
