+
+/* Model 3 census (M0-B): enabled by M3CENSUS=<output prefix>. Real3D RAM
+   footprint, per-frame polygon, vertex, triangle, texture-upload and
+   triangle-area counts. */
+namespace {
+struct m3b_census
+{
+	bool on = false;
+	std::FILE *f = nullptr;
+	std::string prefix;
+	std::vector<uint8_t> dl_w, cull_w, poly_w;
+	uint32_t dl_max = 0, cull_max = 0, poly_max = 0;
+	uint64_t models = 0, polys = 0, polys_vrom = 0, verts_new = 0, verts_reused = 0, fetch_bytes = 0;
+	uint64_t tris_opaque = 0, tris_alpha = 0, tex_uploads = 0, tex_texels = 0, renders = 0;
+	double area = 0;
+	uint64_t frame = 0;
+	double max_area = 0;
+	uint64_t max_polys = 0, max_tris = 0, max_fetch = 0, max_texels = 0;
+
+	m3b_census()
+	{
+		if (char const *const p = std::getenv("M3CENSUS"))
+		{
+			on = true;
+			prefix = p;
+			f = std::fopen((prefix + "_real3d.csv").c_str(), "w");
+			std::fprintf(f, "frame,renders,models,polys,polys_vrom,verts_new,verts_reused,fetch_bytes,tris_opaque,tris_alpha,area_px,tex_uploads,tex_texels,dl_max,cull_max,poly_max\n");
+			dl_w.resize(0x40000);
+			cull_w.resize(0x100000);
+			poly_w.resize(0x100000);
+		}
+	}
+	~m3b_census()
+	{
+		if (!on)
+			return;
+		std::fclose(f);
+		auto count = [](std::vector<uint8_t> const &v) { uint64_t n = 0; for (auto b : v) n += b; return n; };
+		std::FILE *o = std::fopen((prefix + "_real3d.txt").c_str(), "w");
+		std::fprintf(o, "frames %llu\n", (unsigned long long)frame);
+		std::fprintf(o, "display list RAM: highest word written 0x%06X (%.1f KiB span), distinct words %llu (%.1f KiB)\n", dl_max, (dl_max + 1) * 4 / 1024.0, (unsigned long long)count(dl_w), count(dl_w) * 4 / 1024.0);
+		std::fprintf(o, "culling RAM:      highest word written 0x%06X (%.1f KiB span), distinct words %llu (%.1f KiB)\n", cull_max, (cull_max + 1) * 4 / 1024.0, (unsigned long long)count(cull_w), count(cull_w) * 4 / 1024.0);
+		std::fprintf(o, "polygon RAM:      highest word written 0x%06X (%.1f KiB span), distinct words %llu (%.1f KiB)\n", poly_max, (poly_max + 1) * 4 / 1024.0, (unsigned long long)count(poly_w), count(poly_w) * 4 / 1024.0);
+		std::fprintf(o, "per-frame peaks: polys %llu, triangles %llu, fetch bytes %llu, texels uploaded %llu, triangle area %.0f px (%.2fx of 496x384)\n",
+				(unsigned long long)max_polys, (unsigned long long)max_tris, (unsigned long long)max_fetch, (unsigned long long)max_texels, max_area, max_area / (496.0 * 384.0));
+		std::fclose(o);
+	}
+	void mark(std::vector<uint8_t> &v, uint32_t &mx, uint32_t i)
+	{
+		if (i < v.size()) { v[i] = 1; if (i > mx) mx = i; }
+	}
+	void tick()
+	{
+		if (!on)
+			return;
+		std::fprintf(f, "%llu,%llu,%llu,%llu,%llu,%llu,%llu,%llu,%llu,%llu,%.0f,%llu,%llu,%u,%u,%u\n",
+				(unsigned long long)frame, (unsigned long long)renders, (unsigned long long)models, (unsigned long long)polys, (unsigned long long)polys_vrom,
+				(unsigned long long)verts_new, (unsigned long long)verts_reused, (unsigned long long)fetch_bytes,
+				(unsigned long long)tris_opaque, (unsigned long long)tris_alpha, area,
+				(unsigned long long)tex_uploads, (unsigned long long)tex_texels, dl_max, cull_max, poly_max);
+		max_polys = std::max(max_polys, polys);
+		max_tris = std::max(max_tris, tris_opaque + tris_alpha);
+		max_fetch = std::max(max_fetch, fetch_bytes);
+		max_texels = std::max(max_texels, tex_texels);
+		max_area = std::max(max_area, area);
+		renders = models = polys = polys_vrom = verts_new = verts_reused = fetch_bytes = 0;
+		tris_opaque = tris_alpha = tex_uploads = tex_texels = 0;
+		area = 0;
+		frame++;
+	}
+};
+m3b_census g_m3b;
+
+double m3b_area(m3_triangle const *t, int n)
+{
+	double a = 0;
+	for (int i = 0; i < n; i++)
+	{
+		auto const &v = t[i].v;
+		a += std::abs((v[1].x - v[0].x) * (v[2].y - v[0].y) - (v[2].x - v[0].x) * (v[1].y - v[0].y)) * 0.5;
+	}
+	return a;
+}
+} // anonymous namespace
+
+void m3b_frame_tick() { g_m3b.tick(); }
