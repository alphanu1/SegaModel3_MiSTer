+static const CTileGen *g_m3tilegen = nullptr;
+
+void CTileGen::M3Dump(const char *name) const
+{
+	if (gzFile f = gzopen(name, "wb1"))
+	{
+		gzwrite(f, m_vram, 0x120000);
+		gzwrite(f, m_regs, sizeof(m_regs));
+		gzclose(f);
+	}
+}
+
+// Model 3 census: called from CReal3D::RenderFrame for each Real3D dump (M3TILE_DIR)
+void M3DumpTileGen(const char *name)
+{
+	if (g_m3tilegen)
+		g_m3tilegen->M3Dump(name);
+}
