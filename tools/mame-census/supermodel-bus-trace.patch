+// M3BUS_TRACE (system bench, sim/system): every CPU and 53C810 access outside
+// work RAM (and outside CROM reads unless M3BUS_CROM=1), one 24-byte record
+// each: frame, PC, address, kind (0 read, 1 write, 2 event), size, master
+// (0 CPU, 1 53C810), data. Events: size 1 = IRQ assert (data = bits),
+// 2 = ping-pong flip, 3 = frame start (vblank begins).
+#include <cstdio>
+#include <cstdlib>
+#include <cstdint>
+int g_m3bus_master = 0;
+static int g_m3bus_depth = 0;
+static uint32_t g_m3bus_frame = 0;
+static FILE *m3bus_file()
+{
+  static FILE *f = nullptr;
+  static bool tried = false;
+  if (!tried) { tried = true; const char *p = std::getenv("M3BUS_TRACE"); if (p) f = std::fopen(p, "wb"); }
+  return f;
+}
+static bool m3bus_crom() { static int c = -1; if (c < 0) c = std::getenv("M3BUS_CROM") ? 1 : 0; return c == 1; }
+#pragma pack(push, 1)
+struct M3BusRec { uint32_t frame, pc, addr; uint8_t kind, size, master, pad; uint64_t data; };
+#pragma pack(pop)
+static void m3bus_log(int kind, int size, uint32_t addr, uint64_t data)
+{
+  FILE *f = m3bus_file();
+  if (!f) return;
+  if (kind != 2) {
+    if (addr < 0x00800000) return;
+    if (kind == 0 && addr >= 0xFF000000 && !m3bus_crom()) return;
+  }
+  M3BusRec r{g_m3bus_frame, (uint32_t)ppc_get_pc(), addr, (uint8_t)kind, (uint8_t)size, (uint8_t)g_m3bus_master, 0, data};
+  std::fwrite(&r, sizeof(r), 1, f);
+}
+struct M3BusGuard { bool top; M3BusGuard() : top(g_m3bus_depth++ == 0) {} ~M3BusGuard() { g_m3bus_depth--; } };
+
+UINT8 CModel3::Read8(UINT32 addr) { M3BusGuard g; UINT8 d = Read8Impl(addr); if (g.top || g_m3bus_master) m3bus_log(0, 1, addr, d); return d; }
