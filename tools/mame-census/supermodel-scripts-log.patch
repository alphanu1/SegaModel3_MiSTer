+// M0-F capture (M3SCRIPTS_LOG=path): every register access, start, instruction,
+// memory move and interrupt, one line each, prefixed by frame and PPC cycle.
+unsigned g_m3s_frame = 0;
+int g_m3s_width = 0;
+static FILE *M3SLog()
+{
+  static FILE *f = nullptr;
+  static bool init = false;
+  if (!init)
+  {
+    init = true;
+    const char *p = std::getenv("M3SCRIPTS_LOG");
+    if (p)
+      f = std::fopen(p, "w");
+  }
+  return f;
+}
+#include <set>
+#include <string>
+// First access from each PC: save the 1 KiB of code around it (M3SCRIPTS_LOG.code_<pc>.bin)
+static void M3SCode(IBus *bus, UINT32 pc)
+{
+  static std::set<UINT32> seen;
+  const char *p = std::getenv("M3SCRIPTS_LOG");
+  if (!p || pc >= 0x800000 || !seen.insert(pc & ~0x3FF).second)
+    return;
+  char name[600];
+  std::snprintf(name, sizeof(name), "%s.code_%08X.bin", p, pc & ~0x3FF);
+  if (FILE *f = std::fopen(name, "wb"))
+  {
+    for (UINT32 a = pc & ~0x3FF; a < (pc & ~0x3FF) + 0x400; a += 4)
+    {
+      UINT32 w = bus->Read32(a);
+      UINT8 b[4] = { UINT8(w >> 24), UINT8(w >> 16), UINT8(w >> 8), UINT8(w) };
+      std::fwrite(b, 1, 4, f);
+    }
+    std::fclose(f);
+  }
+}
+#define M3S(...) do { if (FILE *f_ = M3SLog()) { std::fprintf(f_, "%u %llu ", g_m3s_frame, (unsigned long long) ppc_total_cycles()); std::fprintf(f_, __VA_ARGS__); } } while (0)
 
