+			for (const char *lev : { "ld1b_r2_n1_w2_d0", "ld1b_b256_n1_w2_d0", "ld1b_r2_n1_w2_da", "ld1b_b256_n1_w2_da",
+				"ld1b_b256_n0_w1_d0", "ld1b_b256_n0_w1_da", "ld1_b256_n0_w1_da", "ld1_b256_n1_w2_da" })
+				for (int wb = 1; wb >= 0; wb--)
+				{
+					std::string const s(lev);
+					m3cpi_fpu f = unified(12, built, false, false, false);
+					for (int cl : { FC_S_ADD, FC_S_MUL, FC_S_FMA }) set(f, cl, 6, 0);
+					set(f, FC_FRSQRTE, 6, 0);
+					f.icbuilt = true; f.ld1b = true; f.ld_use2 = s.compare(0, 4, "ld1_") == 0;
+					f.redirect = 2; f.btb = s.find("_b256_") != std::string::npos ? 256 : 0;
+					f.nl_cost = s.find("_n0") != std::string::npos ? 0 : 1; f.wm_cost = s.find("_w1") != std::string::npos ? 1 : 2;
